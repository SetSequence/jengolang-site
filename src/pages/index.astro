---
export const prerender = true;

import '../styles/marketing.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AmbientKanji from '../components/AmbientKanji.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import JlptBadges from '../components/JlptBadges.astro';
import JLogo from '../components/JLogo.astro';
import { webApp, grammar, privacy } from '../data/links';

const title = "Jengolang — Everything for Japanese, in one place";
const description =
  "A Japanese grammar map, word lists, and dictionary — plus Jengo, the app that puts the whole toolkit in your pocket. iOS and web.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Jengolang",
  url: "https://jengolang.com",
  description,
  inLanguage: "en",
};

const heroChars = [
  { c: "言", x: "5%",  y: "12%", s: "2rem",   op: 0.13, dur: "7.2s", del: "0s" },
  { c: "語", x: "91%", y: "15%", s: "2.3rem", op: 0.12, dur: "8.5s", del: "1.3s" },
  { c: "読", x: "3%",  y: "55%", s: "1.7rem", op: 0.1,  dur: "6.8s", del: "2.7s" },
  { c: "書", x: "88%", y: "52%", s: "2rem",   op: 0.13, dur: "9.1s", del: "0.6s" },
  { c: "文", x: "38%", y: "6%",  s: "1.7rem", op: 0.08, dur: "7.6s", del: "3.8s" },
  { c: "字", x: "68%", y: "9%",  s: "1.9rem", op: 0.11, dur: "8.2s", del: "1.9s" },
  { c: "話", x: "9%",  y: "82%", s: "1.8rem", op: 0.1,  dur: "6.4s", del: "4.5s" },
  { c: "聞", x: "85%", y: "84%", s: "1.7rem", op: 0.12, dur: "7.3s", del: "2.2s" },
];

// TODO(owner): grammarRows is illustrative sample data. If you want the top rows
// pulled live from src/data/grammar_slice.json / the spine, wire that in here.
const grammarRows = [
  { rank: "#1", jp: "は",     gloss: "marks the topic of a sentence" },
  { rank: "#2", jp: "の",     gloss: "connects and possesses" },
  { rank: "#3", jp: "て-form", gloss: "links actions together" },
  { rank: "#4", jp: "ない",   gloss: "makes a verb negative" },
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href="https://jengolang.com/" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Onest:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ─── Hero + hub grid ─────────────────────────── */
    .hub-hero { background: var(--brand-dark); padding: 4.5rem 1.5rem 4rem; position: relative; overflow: hidden; }
    .hub-hero-inner { max-width: 1120px; margin: 0 auto; position: relative; z-index: 1; }
    .hub-kicker { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; color: var(--accent-green); margin: 0 0 1rem; }
    .hub-h1 { font-family: var(--font-serif); font-size: clamp(2.4rem, 1.7rem + 3.2vw, 4rem); font-weight: 500; letter-spacing: -0.015em; line-height: 1.05; color: var(--on-dark); margin: 0; max-width: 18ch; }

    .hub-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-top: 2.75rem; }
    .hub-card { display: flex; flex-direction: column; gap: 0.7rem; background: oklch(99% 0.002 156 / 0.07); border: 1px solid oklch(99.5% 0.002 156 / 0.16); border-radius: 14px; padding: 1.4rem; }
    .hub-card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
    .hub-card-title { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 500; color: var(--on-dark); }
    .hub-card-body { font-size: 0.9rem; color: oklch(99.5% 0.002 156 / 0.65); line-height: 1.55; margin: 0; }
    .hub-card-links { display: flex; align-items: center; gap: 1rem; margin-top: auto; padding-top: 0.75rem; }
    .hub-card-open { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.05em; font-weight: 500; border-radius: 7px; padding: 8px 13px; background: var(--on-dark); color: var(--brand-dark); transition: background 140ms; }
    .hub-card-open:hover { background: oklch(93% 0.01 150); color: var(--brand-dark); }
    .hub-card-more { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--accent-green); white-space: nowrap; }
    .hub-card-more:hover { color: var(--accent-green); }

    .hub-jengo { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem 2rem; align-items: center; background: var(--jengo-card); border-radius: 14px; padding: 1.5rem 1.75rem; margin-top: 1rem; box-shadow: 0 20px 48px -18px oklch(0% 0 0 / 0.4); }
    .hub-jengo-head { display: flex; align-items: center; gap: 0.75rem; }
    .hub-jengo-head svg { border-radius: 6px; flex-shrink: 0; }
    .hub-jengo-name { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 500; color: var(--text); }
    .hub-jengo-pill { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.07em; border-radius: 5px; padding: 4px 9px; background: var(--jengo-pill); color: var(--on-dark); font-weight: 500; }
    .hub-jengo-body { font-size: 0.9rem; color: oklch(35% 0.06 60); line-height: 1.55; margin: 0.5rem 0 0; max-width: 52ch; }
    .hub-jengo-actions { display: flex; align-items: center; gap: 1.25rem; justify-self: end; }
    .hub-jengo-cta { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.05em; font-weight: 500; border-radius: 7px; padding: 9px 15px; background: var(--jengo-pill); color: var(--on-dark); transition: background 140ms; }
    .hub-jengo-cta:hover { background: oklch(46% 0.13 55); color: var(--on-dark); }
    .hub-jengo-more { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: oklch(42% 0.1 55); white-space: nowrap; }
    .hub-jengo-more:hover { color: oklch(42% 0.1 55); }
    @media (max-width: 620px) { .hub-jengo-actions { justify-self: start; } }

    /* ─── §01 Grammar sample card ─────────────────── */
    .gram-card { background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; padding: 0.5rem 1.5rem; box-shadow: 0 20px 44px -20px oklch(24% 0.05 150 / 0.2); max-width: 480px; justify-self: center; width: 100%; }
    .gram-row { display: flex; align-items: baseline; gap: 1.1rem; padding: 0.9rem 0; border-bottom: 1px solid oklch(93% 0.008 110); }
    .gram-rank { font-family: var(--font-mono); font-size: 0.72rem; color: var(--amber); width: 2.4rem; flex-shrink: 0; }
    .gram-jp { font-family: var(--font-jp); font-size: 1.05rem; font-weight: 500; color: var(--text); flex-shrink: 0; }
    .gram-gloss { font-size: 0.875rem; color: var(--text-2); }
    .gram-more { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; color: var(--text-3); padding: 0.9rem 0; margin: 0; }

    /* ─── Shared copy-block helpers ───────────────── */
    .pill-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .dev-wrap { position: relative; }
    .jengo-media { display: flex; align-items: flex-end; justify-content: center; gap: 2.5rem; flex-wrap: wrap; }
    .hub-getjengo { display: inline-flex; align-items: center; gap: 8px; border-radius: 8px; padding: 13px 21px; background: var(--on-dark); font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.05em; font-weight: 500; color: var(--brand-dark); transition: background 140ms; }
    .hub-getjengo:hover { background: oklch(93% 0.01 150); color: var(--brand-dark); }
    .dark-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 0.75rem; }

    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
</head>
<body>
  <SiteNav
    wordmark="Jengolang"
    homeHref="/"
    links={[
      { label: "GRAMMAR", href: "#grammar" },
      { label: "DICTIONARY", href: "#dictionary" },
      { label: "WORD LISTS", href: "#wordlists" },
      { label: "JENGO", href: "#jengo" },
    ]}
    cta={{ label: "OPEN JENGO", href: "/jengo" }}
  />

  <!-- Hero + hub grid -->
  <section class="hub-hero" aria-labelledby="hub-heading">
    <AmbientKanji chars={heroChars} />
    <div class="hub-hero-inner">
      <p class="hub-kicker">日本語 · JAPANESE</p>
      <h1 class="hub-h1" id="hub-heading">A Japanese learning hub</h1>

      <div class="hub-cards">
        <div class="hub-card">
          <div class="hub-card-top">
            <span class="hub-card-title">Grammar</span>
            <span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="5.5" r="2.2"/><circle cx="19" cy="5.5" r="2.2"/><circle cx="12" cy="18.5" r="2.2"/><path d="M7.2 5.5h9.6M6 7.5l4.8 9M18 7.5l-4.8 9"/></svg></span>
          </div>
          <p class="hub-card-body">1,458 grammar points, ranked by usefulness.</p>
          <div class="hub-card-links">
            <a href={grammar} class="hub-card-open">OPEN →</a>
            <a href="#grammar" class="hub-card-more">MORE BELOW ↓</a>
          </div>
        </div>

        <div class="hub-card">
          <div class="hub-card-top">
            <span class="hub-card-title">Dictionary</span>
            <span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9.5 12.5 12 6.5l2.5 6M10.3 10.7h3.4"/></svg></span>
          </div>
          <p class="hub-card-body">Search by kanji, kana, romaji, English, or drawing.</p>
          <div class="hub-card-links">
            <a href={webApp} class="hub-card-open">OPEN →</a>
            <a href="#dictionary" class="hub-card-more">MORE BELOW ↓</a>
          </div>
        </div>

        <div class="hub-card">
          <div class="hub-card-top">
            <span class="hub-card-title">Word lists</span>
            <span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h12M9 12h12M9 18h12"/><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01" stroke-width="2.6"/></svg></span>
          </div>
          <p class="hub-card-body">JLPT N5–N1 word sets and more.</p>
          <div class="hub-card-links">
            <a href={webApp} class="hub-card-open">OPEN →</a>
            <a href="#wordlists" class="hub-card-more">MORE BELOW ↓</a>
          </div>
        </div>
      </div>

      <!-- Jengo: the tying card -->
      <div class="hub-jengo">
        <div>
          <div class="hub-jengo-head">
            <JLogo size={26} />
            <span class="hub-jengo-name">Jengo</span>
            <span class="hub-jengo-pill">THE APP</span>
          </div>
          <p class="hub-jengo-body">Jengo puts the dictionary, the word lists, and spaced-repetition flashcards in one loop — on iPhone and in any browser.</p>
        </div>
        <div class="hub-jengo-actions">
          <a href="/jengo" class="hub-jengo-cta">SEE JENGO →</a>
          <a href="#jengo" class="hub-jengo-more">MORE BELOW ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- §01 Grammar -->
  <section id="grammar" class="mk-sec mk-sec--light">
    <div class="mk-wrap">
      <SectionHeader num="§01" title="Grammar dictionary + learning path" jp="文法" />
      <div class="mk-split">
        <div class="mk-copy">
          <p class="mk-lede">The map covers 1,458 grammar points and ranks them by how useful each one is in real Japanese, not by textbook order. It is free and needs no account.</p>
          <a href={grammar} class="mk-link" style="align-self:flex-start;">BROWSE THE GRAMMAR MAP →</a>
        </div>
        <div class="gram-card">
          {grammarRows.map((g) => (
            <div class="gram-row">
              <span class="gram-rank">{g.rank}</span>
              <span class="gram-jp">{g.jp}</span>
              <span class="gram-gloss">{g.gloss}</span>
            </div>
          ))}
          <p class="gram-more">… 1,454 more, ranked by usefulness</p>
        </div>
      </div>
    </div>
  </section>

  <!-- §02 Dictionary -->
  <section id="dictionary" class="mk-sec mk-sec--alt">
    <div class="mk-wrap">
      <SectionHeader num="§02" title="A clean, tool-packed dictionary" jp="辞書" />
      <div class="mk-split">
        <div class="mk-copy">
          <p class="mk-lede">You can search by kanji, kana, romaji, or English — or draw a kanji you can't type. Every entry carries readings, audio, pitch accent, and examples. The standalone web dictionary is publishing soon; the full version lives in Jengo today.</p>
          <div class="pill-row">
            <span class="mk-pill">PUBLISHING SOON</span>
            <a href="#jengo" class="mk-link">USE IT IN JENGO NOW →</a>
          </div>
        </div>
        <div class="mk-media">
          <div class="dev-wrap">
            <PhoneFrame src="/app-dict-search.png" alt="Dictionary search in Jengo" width={206} rotate={1.5} />
            <div class="mk-annot" style="left:50%;bottom:-2.1rem;transform:translateX(-50%);" aria-hidden="true">
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" stroke="var(--amber)" stroke-width="1.4"><path d="M11 13 L11 4 M11 4 L6 9 M11 4 L16 9"/></svg>
              the dictionary in Jengo today
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- §03 Word lists -->
  <section id="wordlists" class="mk-sec mk-sec--light" style="border-top:1px solid var(--hairline);">
    <div class="mk-wrap">
      <SectionHeader num="§03" title="Word lists, level by level" jp="単語帳" />
      <div class="mk-split">
        <div class="mk-copy">
          <p class="mk-lede">JLPT N5 through N1, deduplicated — 700 to 2,900 words per level. The browsable lists are publishing soon on this site, and each one imports into Jengo as a ready-made deck.</p>
          <JlptBadges />
          <div class="pill-row">
            <span class="mk-pill">PUBLISHING SOON</span>
            <a href="#jengo" class="mk-link">STUDY THEM IN JENGO NOW →</a>
          </div>
        </div>
        <div class="mk-media">
          <PhoneFrame src="/app-decks.png" alt="JLPT decks in Jengo" width={206} rotate={-1.5} />
        </div>
      </div>
    </div>
  </section>

  <!-- §04 Jengo -->
  <section id="jengo" class="mk-sec mk-sec--dark">
    <div class="mk-wrap">
      <SectionHeader num="§04" title="Jengo ties it together" jp="アプリ" tone="dark" />
      <div class="mk-split">
        <div class="mk-copy">
          <p class="mk-lede">The dictionary, the word lists, and spaced-repetition flashcards live in one app. You look a word up, add it in a tap, and review it right before you'd forget it — offline on iPhone, synced to any browser.</p>
          <div class="dark-actions">
            <a href="/jengo" class="hub-getjengo">GET JENGO →</a>
            <a href={webApp} class="mk-link mk-link--green">OPEN IN BROWSER →</a>
          </div>
        </div>
        <div class="jengo-media">
          <div class="dev-wrap">
            <PhoneFrame src="/app-dict-entry.png" alt="A dictionary entry in Jengo" width={196} rotate={-1.5} />
            <div class="mk-annot mk-annot--dark" style="left:50%;bottom:-2.1rem;transform:translateX(-50%);" aria-hidden="true">
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" stroke="var(--amber-2)" stroke-width="1.4"><path d="M11 13 L11 4 M11 4 L6 9 M11 4 L16 9"/></svg>
              synced between iPhone and browser
            </div>
          </div>
          <PhoneFrame src="/app-flashcard-front.png" alt="A flashcard in Jengo" width={196} rotate={1.5} />
        </div>
      </div>
    </div>
  </section>

  <SiteFooter
    wordmark="Jengolang"
    homeHref="/"
    links={[
      { label: "GRAMMAR", href: "#grammar" },
      { label: "DICTIONARY", href: "#dictionary" },
      { label: "WORD LISTS", href: "#wordlists" },
      { label: "JENGO APP", href: "#jengo" },
      { label: "PRIVACY", href: privacy },
    ]}
  />
</body>
</html>
