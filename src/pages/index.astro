---
export const prerender = true;

const title = "Jengolang — Everything for Japanese, in one place";
const description =
  "A Japanese grammar map, word lists, and dictionary — plus Jengo, the app that puts the whole toolkit in your pocket. iOS and web.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Jengolang",
  url: "https://jengolang.com",
  description,
  inLanguage: "en",
};
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href="https://jengolang.com/" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --brand:       oklch(47% 0.089 156);
      --brand-dark:  oklch(25% 0.062 156);
      --brand-tint:  oklch(96% 0.016 156);
      --accent:      oklch(74% 0.11 145);
      --on-dark:     oklch(99% 0.002 156);
      --on-dim:      oklch(99% 0.002 156 / 0.6);
      --on-faint:    oklch(99% 0.002 156 / 0.4);
      --hairline:    oklch(99% 0.002 156 / 0.12);
      --text-dark:   oklch(22% 0.010 156);
      --text-mid:    oklch(50% 0.012 156);
    }
    html { font-optical-sizing: auto; scroll-behavior: smooth; }
    body {
      font-family: 'Onest', system-ui, sans-serif;
      line-height: 1.6;
      color: var(--on-dark);
      background: var(--brand-dark);
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    @keyframes charPulse { 0%,100% { opacity: 0; } 25%,75% { opacity: var(--op); } }
  </style>
  <style>
    .hub { position: relative; max-width: 1120px; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); overflow: hidden; }

    /* ambient kanji */
    .ambient { position: absolute; inset: 0; pointer-events: none; z-index: 0;
      font-family: 'Noto Sans JP', sans-serif; font-weight: 500; color: #fff; }
    .ambient span { position: absolute; opacity: 0; animation: charPulse var(--d) var(--delay) infinite; }

    nav, .hero, .tools, .foot { position: relative; z-index: 2; }

    /* nav */
    nav { height: 64px; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand span { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; }
    .logo { width: 28px; height: 28px; border-radius: 6px; }
    .nav-links { display: flex; align-items: center; gap: 1.4rem; font-size: .84rem; font-weight: 500; }
    .nav-links a.link { color: var(--on-dim); transition: color .15s; }
    .nav-links a.link:hover { color: var(--on-dark); }
    .nav-links a.cta { color: var(--on-dark); border: 1.5px solid oklch(99% 0.002 156 / 0.25);
      border-radius: 8px; padding: 7px 15px; transition: background .15s; }
    .nav-links a.cta:hover { background: oklch(99% 0.002 156 / 0.1); }

    /* hero */
    .hero { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 2.5rem; align-items: center;
      padding: clamp(2.5rem, 6vw, 3.5rem) 0 clamp(2rem, 5vw, 2.75rem); }
    .kicker { font-family: 'JetBrains Mono', monospace; font-size: .75rem; letter-spacing: 0.14em;
      color: var(--accent); font-weight: 500; }
    .hero h1 { font-size: clamp(2.1rem, 5.2vw, 3rem); font-weight: 800; letter-spacing: -0.03em;
      line-height: 1.05; margin-top: 1rem; max-width: 16ch; }
    .hero h1 em { font-style: normal; color: var(--accent); }
    .hero p { font-size: clamp(1rem, 2.4vw, 1.05rem); line-height: 1.6; color: oklch(80% 0.014 156);
      margin-top: 1.1rem; max-width: 42ch; }
    .cta-row { display: flex; align-items: center; gap: 0.9rem; margin-top: 1.75rem; flex-wrap: wrap; }
    .cta-primary { display: inline-flex; align-items: center; gap: 8px; background: var(--brand);
      color: #fff; font-size: .95rem; font-weight: 600; border-radius: 9px; padding: 12px 22px; transition: background .15s; }
    .cta-primary:hover { background: oklch(53% 0.1 156); }
    .cta-note { font-size: .82rem; font-weight: 500; color: var(--on-dim); }

    /* phone */
    .phone-wrap { display: flex; justify-content: center; }
    .phone { width: 258px; max-width: 100%; background: oklch(16% 0.005 270); border-radius: 36px;
      padding: 9px; box-shadow: 0 28px 64px oklch(0% 0 0 / 0.45); }
    .phone-screen { background: oklch(98.5% 0.005 156); border-radius: 28px; overflow: hidden; color: var(--text-dark); }
    .phone-top { background: var(--brand-dark); padding: 18px 18px 15px; display: flex; align-items: center; gap: 8px; }
    .phone-top span { font-size: .95rem; font-weight: 700; color: #fff; }
    .phone-body { padding: 16px 15px 20px; }
    .phone-label { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em;
      color: oklch(60% 0.01 156); margin-bottom: 11px; }
    .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .tile { display: flex; flex-direction: column; gap: 9px; padding: 15px 14px; border-radius: 14px;
      background: var(--brand-tint); color: oklch(32% 0.012 156);
      transition: background .3s cubic-bezier(.16,1,.3,1), color .3s, box-shadow .3s; }
    .tile span { font-size: .8rem; font-weight: 600; }
    .tile.active { background: var(--brand); color: #fff; box-shadow: 0 8px 20px oklch(47% 0.089 156 / 0.28); }

    /* tools */
    .tools { padding: 0.5rem 0 2rem; }
    .tools-kicker { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em;
      color: var(--on-faint); }
    .tools-grid { margin-top: 0.9rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
    .tool { display: flex; flex-direction: column; gap: 0.6rem; min-height: 148px;
      background: oklch(99% 0.002 156 / 0.06); border: 1px solid var(--hairline); border-radius: 14px; padding: 1.25rem;
      transition: background .2s, transform .2s cubic-bezier(.16,1,.3,1); }
    a.tool:hover { background: oklch(99% 0.002 156 / 0.12); transform: translateY(-3px); }
    .tool-top { display: flex; align-items: center; justify-content: space-between; }
    .tool-top .icon { color: #fff; }
    .tag { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--on-dim); border: 1px solid var(--hairline); border-radius: 5px; padding: 3px 7px; }
    .tool h2 { font-size: 1rem; font-weight: 700; margin-top: 0.15rem; }
    .tool p { font-size: .8rem; color: var(--on-dim); line-height: 1.5; }
    .tool .go { font-size: .8rem; font-weight: 600; color: var(--accent); margin-top: auto; }

    /* footer */
    .foot { border-top: 1px solid var(--hairline); padding: 20px 0; display: flex; align-items: center;
      justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .foot .copy { font-size: .82rem; color: var(--on-faint); }
    .foot-links { display: flex; gap: 1.25rem; font-size: .82rem; color: var(--on-dim); }
    .foot-links a:hover { color: #fff; }

    @media (max-width: 860px) {
      .hero { grid-template-columns: 1fr; gap: 2.25rem; }
      .phone-wrap { order: -1; }
      .tools-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ambient span { animation: none; opacity: 0 !important; }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>
  <div class="hub">
    <div class="ambient" aria-hidden="true">
      <span style="left:5%;top:12%;font-size:34px;--op:.09;--d:7.2s;--delay:0s">言</span>
      <span style="left:90%;top:16%;font-size:40px;--op:.08;--d:8.5s;--delay:1.3s">語</span>
      <span style="left:12%;top:64%;font-size:30px;--op:.07;--d:6.8s;--delay:2.7s">読</span>
      <span style="left:84%;top:70%;font-size:36px;--op:.08;--d:9.1s;--delay:.6s">書</span>
      <span style="left:3%;top:40%;font-size:28px;--op:.06;--d:7.6s;--delay:3.8s">文</span>
      <span style="left:94%;top:44%;font-size:32px;--op:.07;--d:8.2s;--delay:1.9s">字</span>
      <span style="left:22%;top:8%;font-size:26px;--op:.06;--d:6.4s;--delay:4.5s">話</span>
      <span style="left:74%;top:90%;font-size:30px;--op:.07;--d:7.3s;--delay:2.2s">聞</span>
    </div>

    <nav>
      <a class="brand" href="/">
        <svg class="logo" viewBox="0 0 512 512"><rect width="512" height="512" fill="oklch(47% 0.089 156)"/><text x="256" y="366" font-family="Georgia, serif" font-size="330" font-weight="bold" fill="#fff" text-anchor="middle">J</text></svg>
        <span>Jengolang</span>
      </a>
      <div class="nav-links">
        <a class="link" href="/learn/japanese/grammar">Grammar</a>
        <a class="cta" href="/jengo">Open Jengo</a>
      </div>
    </nav>

    <header class="hero">
      <div class="pitch">
        <div class="kicker">日本語 · JAPANESE</div>
        <h1>Everything for Japanese, <em>in one place.</em></h1>
        <p>A dictionary, word lists, and a grammar map — plus Jengo, the app that puts the whole toolkit in your pocket.</p>
        <div class="cta-row">
          <a class="cta-primary" href="/jengo">Open Jengo <span aria-hidden="true">→</span></a>
          <span class="cta-note">iOS · Web · free to start</span>
        </div>
      </div>

      <div class="phone-wrap">
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-top">
              <svg class="logo" style="width:22px;height:22px" viewBox="0 0 512 512"><rect width="512" height="512" fill="oklch(47% 0.089 156)"/><text x="256" y="366" font-family="Georgia, serif" font-size="330" font-weight="bold" fill="#fff" text-anchor="middle">J</text></svg>
              <span>Jengo</span>
            </div>
            <div class="phone-body">
              <div class="phone-label">Your toolkit</div>
              <div class="tiles">
                <div class="tile active" data-tile="0"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg><span>Dictionary</span></div>
                <div class="tile" data-tile="1"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="14" height="13" rx="2"/><path d="M7 8V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3"/></svg><span>Flashcards</span></div>
                <div class="tile" data-tile="2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4H11v15.5H3.5A1.5 1.5 0 0 1 2 18z"/><path d="M22 5.5A1.5 1.5 0 0 0 20.5 4H13v15.5h7.5A1.5 1.5 0 0 0 22 18z"/></svg><span>Grammar</span></div>
                <div class="tile" data-tile="3"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 8L9 4l-3 8H2"/></svg><span>Train</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class="tools">
      <span class="tools-kicker">The rest of Jengolang</span>
      <div class="tools-grid">
        <a class="tool" href="/learn/japanese/grammar">
          <div class="tool-top">
            <span class="icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5.5A1.5 1.5 0 0 1 3.5 4H11v15.5H3.5A1.5 1.5 0 0 1 2 18z"/><path d="M22 5.5A1.5 1.5 0 0 0 20.5 4H13v15.5h7.5A1.5 1.5 0 0 0 22 18z"/></svg></span>
          </div>
          <h2>Grammar</h2>
          <p>1,458 grammar points, ranked by usefulness — not by textbook.</p>
          <span class="go">Browse →</span>
        </a>

        <a class="tool" href="/jengo">
          <div class="tool-top">
            <span class="icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
            <span class="tag">In app only</span>
          </div>
          <h2>Dictionary</h2>
          <p>Kanji, kana, drawing, romaji — four ways in to every word.</p>
          <span class="go">See it in Jengo →</span>
        </a>

        <a class="tool" href="/jengo">
          <div class="tool-top">
            <span class="icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="14" height="13" rx="2"/><path d="M7 8V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3"/></svg></span>
            <span class="tag">In app only</span>
          </div>
          <h2>Word lists</h2>
          <p>JLPT N5–N1 decks, deduplicated and ready to review.</p>
          <span class="go">See it in Jengo →</span>
        </a>
      </div>
    </section>

    <footer class="foot">
      <span class="copy">© 2026 Jengolang · Japanese</span>
      <div class="foot-links">
        <a href="/jengo">Jengo app</a>
        <a href="/learn/japanese/grammar">Grammar</a>
        <a href="https://app.jengolang.com/privacy">Privacy</a>
      </div>
    </footer>
  </div>

  <script>
    const tiles = Array.from(document.querySelectorAll('.tile'));
    let mode = 0;
    let timer = setInterval(step, 2400);
    function light(i) {
      mode = i;
      tiles.forEach((t, idx) => t.classList.toggle('active', idx === i));
    }
    function step() { light((mode + 1) % tiles.length); }
    tiles.forEach((t, i) => t.addEventListener('click', () => { clearInterval(timer); light(i); }));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) clearInterval(timer);
  </script>
</body>
</html>
