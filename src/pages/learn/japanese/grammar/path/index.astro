---
import GrammarModeSwitcher from "../../../../../components/GrammarModeSwitcher.astro";
import GrammarShell from "../../../../../components/GrammarShell.astro";
import slice from "../../../../../data/grammar_slice.json";
export const prerender=true;
const arcs=slice.spine.arcs;
const total=slice.spine.node_count;
const title="Japanese Grammar Path — Jengo";
const description="A complete, zero-lock path through Japanese grammar, organized into arcs and units with progress saved on your device.";
---
<GrammarShell title={title} description={description} canonical="https://jengolang.com/learn/japanese/grammar/path">
  <main class="grammar-wrap path-wrap">
    <GrammarModeSwitcher mode="path" />
    <header class="page-head">
      <h1 class="sr-only">Japanese Grammar Path</h1>
      <div class="path-tools"><div class="summary"><span><strong id="learned-total">0</strong> of {total.toLocaleString()} learned</span><span id="total-pct">0%</span></div><button id="open-placement" type="button">Find my place</button></div>
      <div class="bar"><i id="total-bar" data-total={total}></i></div>
    </header>

    <section id="placement-panel" class="placement-panel" hidden aria-labelledby="placement-title">
      <button id="close-placement" class="close-placement" type="button" aria-label="Close placement">×</button>
      <div id="placement-intro">
        <small>Find your place</small><h2 id="placement-title">What can you already do?</h2><p>Choose the first statement that fits. This only recommends a starting unit; it never marks grammar as learned for you.</p>
        <div class="placement-options">
          <button class="placement-choice" data-start="start" type="button"><strong>I am new to Japanese</strong><span>I am still learning kana or my first sentences.</span></button>
          <button class="placement-choice" data-start="2" type="button"><strong>I can make a basic です sentence</strong><span>For example: “This is a book.”</span></button>
          <button class="placement-choice" data-start="5" type="button"><strong>I can connect actions with the て-form</strong><span>I can make polite verbs, use basic particles, and join simple actions with て.</span></button>
          <button class="placement-choice" data-start="1" type="button"><strong>I want to choose for myself</strong><span>Browse every unit without changing progress.</span></button>
        </div>
      </div>
      <div id="placement-result" hidden><small>Your recommendation</small><h2 id="placed-count">Start with Unit 1.</h2><p id="placed-start"></p><a id="jump-to-start" href="#">Open this unit →</a><button id="placement-again" type="button">Choose a different answer</button><span>Nothing is marked learned. Adjust individual points whenever you like.</span></div>
    </section>

    <div id="arcs" class="arcs">
      {arcs.map((arc) => <section class="arc" data-arc={arc.index}>
        <header><div><small>Arc {arc.index}</small><h2>{arc.label}</h2><p>{arc.units.length+(arc.index===1?1:0)} units · {arc.node_count} points</p></div><strong class="arc-progress">0%</strong></header>
        <div class="arc-bar"><i></i></div>
        <div class="units">
          {arc.index===1&&<div class="primer-unit" data-slug="grammar-path-primer"><button class="primer-check" type="button" aria-label="Mark Unit 0 learned" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="m20 6-11 11-5-5"/></svg></button><a href="/learn/japanese/grammar/path/start"><span class="unit-index">0</span><span class="unit-copy"><strong>Start here: Japanese sentence basics</strong><small>Kana readiness and the ideas used in Unit 1</small></span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></a></div>}
          {arc.units.map((unit) => <details class="unit" id={`unit-${unit.index}`} data-slugs={unit.nodes.map((n)=>n.slug).join(" ")}>
            <summary><span class="unit-index">{unit.index}</span><span class="unit-copy"><strong>{unit.label}</strong><small>{unit.node_count} points</small></span><span class="unit-progress">0/{unit.node_count}</span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></summary>
            <div class="unit-nodes">
              {unit.nodes.map((node)=><div class="path-node" data-slug={node.slug}>
                <button class="node-check" type="button" aria-label={`Mark ${node.canonical} learned`} aria-pressed="false"><svg viewBox="0 0 24 24"><path d="m20 6-11 11-5-5"/></svg></button>
                <a href={`/learn/japanese/grammar/${node.slug}`}><span>{node.canonical}</span><small>{node.meaning}</small></a>
                <span class="jlpt" data-level={node.jlpt}>{node.jlpt}</span>
              </div>)}
              <div class="unit-actions"><button class="mark-unit" type="button">I know this unit</button><button class="clear-unit" type="button">Clear</button></div>
            </div>
          </details>)}
        </div>
      </section>)}
    </div>
  </main>
  <script type="module">
    function setupPath(){
    const progress=window.__jengoGrammarProgress;
    const root=document.querySelector(".path-wrap");
    if(!progress||!root||root.dataset.progressReady)return;
    root.dataset.progressReady="true";
    const {connectProgress,isLearned,loadProgress,saveProgress,setLearned}=progress;
    let state=loadProgress();
    const units=[...document.querySelectorAll(".unit")],cards=[...document.querySelectorAll(".path-node")],primer=document.querySelector(".primer-unit");
    const nodeTotal=Number(document.querySelector("#total-bar").dataset.total)||cards.length;
    const learned=(slug)=>isLearned(state,slug);
    function render(){let all=0;document.querySelectorAll(".arc").forEach((arc)=>{let done=0,total=0;arc.querySelectorAll(".unit").forEach((unit)=>{const slugs=unit.dataset.slugs.split(" "),n=slugs.filter(learned).length;done+=n;total+=slugs.length;unit.querySelector(".unit-progress").textContent=`${n}/${slugs.length}`;unit.classList.toggle("complete",n===slugs.length)});all+=done;const pct=total?Math.round(done/total*100):0;arc.querySelector(".arc-progress").textContent=`${pct}%`;arc.querySelector(".arc-bar i").style.width=`${pct}%`});cards.forEach((card)=>{const on=learned(card.dataset.slug);card.classList.toggle("learned",on);card.querySelector(".node-check").setAttribute("aria-pressed",String(on))});if(primer){const on=learned(primer.dataset.slug);primer.classList.toggle("learned",on);primer.querySelector(".primer-check").setAttribute("aria-pressed",String(on))}const pct=Math.round(all/nodeTotal*100);document.querySelector("#learned-total").textContent=all;document.querySelector("#total-pct").textContent=`${pct}%`;document.querySelector("#total-bar").style.width=`${pct}%`}
    cards.forEach((card)=>card.querySelector(".node-check").addEventListener("click",()=>{const slug=card.dataset.slug;setLearned(state,slug,!learned(slug));saveProgress(state,[slug]);render()}));
    primer?.querySelector(".primer-check").addEventListener("click",()=>{const slug=primer.dataset.slug;setLearned(state,slug,!learned(slug));saveProgress(state,[slug]);render()});
    units.forEach((unit)=>{const set=(value)=>{const slugs=unit.dataset.slugs.split(" ");slugs.forEach((slug)=>setLearned(state,slug,value));saveProgress(state,slugs);render()};unit.querySelector(".mark-unit").addEventListener("click",()=>set(true));unit.querySelector(".clear-unit").addEventListener("click",()=>set(false));unit.addEventListener("toggle",()=>{if(unit.open)history.replaceState(history.state,"",`#${unit.id}`);else if(location.hash===`#${unit.id}`)history.replaceState(history.state,"",location.pathname+location.search)});});
    const panel=document.querySelector("#placement-panel"),intro=document.querySelector("#placement-intro"),result=document.querySelector("#placement-result");
    const show=(which)=>{[intro,result].forEach((x)=>x.hidden=x!==which);panel.hidden=false;panel.scrollIntoView({behavior:"smooth",block:"center"})};const close=()=>{panel.hidden=true};
    document.querySelector("#open-placement").addEventListener("click",()=>show(intro));document.querySelector("#close-placement").addEventListener("click",close);document.querySelector("#placement-again").addEventListener("click",()=>show(intro));
    document.querySelectorAll(".placement-choice").forEach((choice)=>choice.addEventListener("click",()=>{const target=choice.dataset.start;if(target==="start"){window.location.assign("/learn/japanese/grammar/path/start");return}const start=document.querySelector(`#unit-${target}`);document.querySelector("#placed-count").textContent=`Start with Unit ${target}.`;document.querySelector("#placed-start").textContent=`${start.querySelector(".unit-copy strong").textContent} is the next useful foundation for what you already know.`;const jump=document.querySelector("#jump-to-start");jump.href=`#${start.id}`;jump.onclick=(event)=>{event.preventDefault();start.open=true;start.scrollIntoView({behavior:"smooth",block:"start"});close()};show(result)}));
    const restoreUnit=()=>{const unit=location.hash&&document.querySelector(location.hash);if(unit instanceof HTMLDetailsElement){unit.open=true;unit.scrollIntoView({block:"start"})}};
    connectProgress((next)=>{state=next;render()});render();requestAnimationFrame(restoreUnit);
    }
    document.addEventListener("astro:page-load",setupPath);
  </script>
</GrammarShell>
<style>
  .path-wrap{width:min(100% - 32px,860px)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.page-head{margin-top:16px}.path-tools{display:flex;align-items:center;justify-content:space-between;gap:14px}.path-tools>button{min-height:40px;padding:8px 13px;border:1px solid color-mix(in oklab,var(--brand) 30%,var(--border));border-radius:9px;background:var(--brand-tint);color:var(--brand);font-size:.78rem;font-weight:750;cursor:pointer}.path-tools>button:active{background:color-mix(in oklab,var(--brand) 16%,var(--surface))}.summary{display:flex;gap:12px;color:var(--text-secondary);font-size:.82rem}.summary strong{color:var(--text-primary)}.bar,.arc-bar{height:6px;margin-top:9px;overflow:hidden;border-radius:99px;background:oklch(91% .008 156)}.bar i,.arc-bar i{display:block;width:0;height:100%;border-radius:inherit;background:var(--learned);transition:width .2s ease-out}
  .placement-panel{position:relative;margin-top:28px;padding:22px;border:1px solid var(--border);border-radius:14px;background:var(--surface)}.placement-panel small{font-size:.66rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-tertiary)}.placement-panel h2{margin-top:4px;font-size:1.2rem}.placement-panel p{margin-top:5px;color:var(--text-secondary);font-size:.82rem}.close-placement{position:absolute;right:12px;top:10px;border:0;background:none;color:var(--text-tertiary);font-size:1.3rem;cursor:pointer}.placement-options{display:grid;gap:8px;margin-top:16px}.placement-choice{display:grid;gap:2px;padding:11px 12px;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--text-primary);text-align:left;cursor:pointer}.placement-choice:hover,.placement-choice:focus-visible{border-color:var(--brand);background:var(--brand-tint)}.placement-choice strong{font-size:.8rem}.placement-choice span{color:var(--text-secondary);font-size:.74rem}#placement-result{text-align:center}#placement-result>a{display:block;margin-top:18px;padding:10px;border-radius:8px;background:var(--brand);color:var(--white);font-size:.82rem;font-weight:700;text-decoration:none}#placement-again{margin-top:9px;border:0;background:none;color:var(--brand);font-size:.75rem;font-weight:700;cursor:pointer}#placement-result>span{display:block;margin-top:8px;color:var(--text-tertiary);font-size:.7rem}
  .arcs{display:grid;gap:14px;margin-top:26px}.arc{--arc:var(--brand);padding:22px 0 0;background:color-mix(in oklab,var(--arc) 5%,var(--bg))}.arc:nth-child(2){--arc:oklch(52% .09 190)}.arc:nth-child(3){--arc:oklch(51% .09 230)}.arc:nth-child(4){--arc:oklch(52% .10 275)}.arc:nth-child(5){--arc:oklch(52% .10 320)}.arc:nth-child(6){--arc:oklch(53% .10 25)}.arc:nth-child(7){--arc:oklch(55% .10 60)}.arc:nth-child(8){--arc:oklch(51% .08 95)}.arc:nth-child(9){--arc:oklch(46% .06 120)}.arc>header,.arc-bar{margin-inline:16px}.arc>header{display:flex;justify-content:space-between;gap:16px}.arc>header small{font-size:.67rem;font-weight:750;letter-spacing:.06em;text-transform:uppercase;color:var(--arc)}.arc h2{font-size:1.18rem;letter-spacing:-.015em}.arc header p{margin-top:2px;color:var(--text-secondary);font-size:.76rem}.arc-progress{align-self:center;color:var(--arc);font-size:.82rem}.arc-bar{height:4px;margin-top:13px}.arc-bar i{background:var(--arc)}.units{margin-top:12px}.primer-unit{display:grid;grid-template-columns:24px minmax(0,1fr);align-items:center;gap:9px;min-height:66px;padding:10px 16px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:color-mix(in oklab,var(--arc) 7%,var(--surface))}.primer-unit>a{display:grid;grid-template-columns:34px minmax(0,1fr) 16px;align-items:center;gap:10px;text-decoration:none}.primer-unit>a>svg{width:16px;fill:none;stroke:var(--text-tertiary);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.primer-check{width:21px;height:21px;border:1.5px solid var(--border-strong);border-radius:6px;background:transparent;cursor:pointer}.primer-check svg{width:12px;fill:none;stroke:transparent;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}.primer-unit.learned .primer-check{border-color:var(--learned);background:var(--learned)}.primer-unit.learned .primer-check svg{stroke:var(--white)}.unit{border-bottom:1px solid var(--border)}.unit summary{display:grid;grid-template-columns:34px 1fr auto 16px;align-items:center;gap:10px;min-height:62px;padding:10px 16px;cursor:pointer;list-style:none}.unit summary::-webkit-details-marker{display:none}.unit summary:hover{background:color-mix(in oklab,var(--arc) 7%,var(--surface))}.unit summary>svg{width:16px;fill:none;stroke:var(--text-tertiary);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .18s ease-out}.unit[open] summary>svg{transform:rotate(90deg)}.unit-index{width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--border-strong);border-radius:8px;color:var(--text-secondary);font-size:.75rem;font-weight:700}.unit.complete .unit-index{border-color:var(--learned);background:var(--learned);color:var(--white)}.primer-unit.learned .unit-index{border-color:var(--learned);background:var(--learned);color:var(--white)}.unit-copy{display:grid;min-width:0}.unit-copy strong{font-size:.84rem}.unit-copy small{font-size:.7rem;font-weight:500;color:var(--text-tertiary)}.unit-progress{font-size:.72rem;color:var(--text-tertiary)}
  .unit-nodes{background:var(--surface)}.path-node{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:9px;padding:10px 16px;border-top:1px solid var(--border)}.node-check{width:21px;height:21px;border:1.5px solid var(--border-strong);border-radius:6px;background:transparent;cursor:pointer}.node-check svg{width:12px;fill:none;stroke:transparent;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}.path-node.learned .node-check{border-color:var(--learned);background:var(--learned)}.path-node.learned .node-check svg{stroke:var(--white)}.path-node>a{display:grid;gap:2px;min-width:0;text-decoration:none}.path-node>a>span{font-family:"Noto Sans JP",sans-serif;font-size:.95rem;font-weight:600}.path-node>a>small{color:var(--text-secondary);font-size:.75rem;line-height:1.35}.jlpt{padding:2px 6px;border-radius:5px;background:var(--text-tertiary);color:var(--white);font-size:.6rem;font-weight:700}.jlpt[data-level="N5"]{background:oklch(55% .10 156)}.jlpt[data-level="N4"]{background:oklch(55% .10 200)}.jlpt[data-level="N3"]{background:oklch(55% .11 250)}.jlpt[data-level="N2"]{background:oklch(52% .12 300)}.jlpt[data-level="N1"]{background:oklch(50% .13 340)}.unit-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 16px;border-top:1px solid var(--border)}.unit-actions button{padding:7px 9px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text-secondary);font-size:.68rem;font-weight:600;cursor:pointer}.unit-actions .mark-unit{color:var(--learned)}
  @media(min-width:700px){.placement-options{grid-template-columns:1fr 1fr}.placement-panel{padding:26px}.arc{padding:26px 22px 20px}.path-node>a{grid-template-columns:120px 1fr;align-items:baseline;gap:12px}}
</style>
