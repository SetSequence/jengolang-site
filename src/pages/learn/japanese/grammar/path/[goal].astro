---
import { getCollection } from "astro:content";
import { GOALS, GOAL_BY_ID } from "../../../../../lib/goals";
import { glossOf, groupByFamily, jlptColor } from "../../../../../lib/grammar";
import slice from "../../../../../data/grammar_slice.json";

export const prerender = true;

export function getStaticPaths() {
  return GOALS.map((g) => ({ params: { goal: g.id } }));
}

const goalId = Astro.params.goal;
const goal = GOAL_BY_ID.get(goalId);
if (!goal) throw new Error(`Unknown goal route: ${goalId}`);

// Membership + ordering are canonical in the slice (built by build_slice.py per
// ON-RAILS.md); this page only joins slugs to the content collection for the
// state that lives there (written guide? gloss?).
const gdata = slice.goals.find((g) => g.id === goalId);
if (!gdata) throw new Error(`No goal path in slice for: ${goalId}`);

const all = await getCollection("grammar");
const meta = new Map(
  all.map((e) => [e.id, { written: !e.data.noindex, gloss: glossOf(e.data) }]),
);
const enrich = (n) => ({
  ...n,
  written: meta.get(n.slug)?.written ?? false,
  gloss: meta.get(n.slug)?.gloss ?? n.meaning,
});

const bandMode = gdata.foundations_mode; // "band0" (JLPT) | "spine" (register)
const foundationNodes = slice.foundations.nodes.map(enrich);
const goalBands = gdata.bands.map((b) => ({ ...b, nodes: b.nodes.map(enrich) }));

// The numbered path. For JLPT goals the Foundations trunk is the numbered Band 1
// (the trunk *is* the content); for register goals it's a compact assumed spine
// shown above, and the path starts at the goal's own first band. (ON-RAILS §3)
const pathBands =
  bandMode === "band0"
    ? [
        {
          index: 0,
          key: "foundations",
          label: "Foundations — the shared spine",
          nodes: foundationNodes,
        },
        ...goalBands,
      ]
    : goalBands;

// Hero "start here" rail = the true first step: the trunk for JLPT goals, the
// goal's own first band for register goals (Foundations assumed). (ON-RAILS §4)
const railSource =
  bandMode === "band0" ? foundationNodes : goalBands[0]?.nodes ?? [];
const rail = railSource.slice(0, 6);

// read-novels: literary members not on the curated route → family grid below.
const restNodes = (gdata.rest_members ?? [])
  .map((slug) => {
    const e = meta.has(slug) ? all.find((x) => x.id === slug) : null;
    return e
      ? {
          slug,
          canonical: e.data.canonical,
          reading: e.data.reading,
          gloss: glossOf(e.data),
          register: e.data.register,
          freq: e.data.freq,
          jlpt: e.data.jlpt,
          family: e.data.family,
          written: !e.data.noindex,
        }
      : null;
  })
  .filter(Boolean);
const restGroups = groupByFamily(restNodes);

const allPathNodes = [...pathBands.flatMap((b) => b.nodes), ...restNodes];
const total = allPathNodes.length;
const writtenCount = allPathNodes.filter((n) => n.written).length;

const others = GOALS.filter((g) => g.id !== goal.id);
const base = "https://jengolang.com";
const canonical = `${base}/learn/japanese/grammar/path/${goal.id}`;

// Structured data: ItemList of the substantive (written-guide) pages in path
// order for GEO, plus a breadcrumb trail. Cap so the page stays light.
const listItems = (writtenCount > 0 ? allPathNodes.filter((n) => n.written) : allPathNodes)
  .slice(0, 200)
  .map((n, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${n.canonical} — ${n.gloss}`,
    url: `${base}/learn/japanese/grammar/${n.slug}`,
  }));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: goal.h1,
    description: goal.description,
    numberOfItems: listItems.length,
    itemListElement: listItems,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Japanese", item: `${base}/learn/japanese` },
      { "@type": "ListItem", position: 2, name: "Grammar", item: `${base}/learn/japanese/grammar` },
      { "@type": "ListItem", position: 3, name: goal.label, item: canonical },
    ],
  },
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={goal.description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <title>{goal.title}</title>
  <meta property="og:type" content="website" />
  <meta property="og:title" content={goal.title} />
  <meta property="og:description" content={goal.description} />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --brand:          oklch(47% 0.089 156);
      --brand-dark:     oklch(25% 0.062 156);
      --brand-tint:     oklch(96% 0.016 156);
      --bg:             oklch(98.5% 0.005 156);
      --surface:        oklch(99% 0.003 156);
      --border:         oklch(90% 0.008 156);
      --text-primary:   oklch(22% 0.010 156);
      --text-secondary: oklch(50% 0.012 156);
      --text-tertiary:  oklch(68% 0.008 156);
      --white:          oklch(99.5% 0.002 156);
    }
    html { font-optical-sizing: auto; scroll-behavior: smooth; }
    body {
      font-family: 'Onest', system-ui, sans-serif;
      line-height: 1.6;
      color: var(--text-primary);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
  </style>
  <style>
    .nav { background: var(--brand-dark); position: sticky; top: 0; z-index: 100; }
    .nav-inner {
      max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; height: 56px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .nav-wordmark { font-size: 1rem; font-weight: 600; color: var(--white); letter-spacing: -0.01em; text-decoration: none; }
    .nav a.try { font-size: .8rem; font-weight: 600; color: var(--white); text-decoration: none;
      border: 1px solid oklch(99.5% 0.002 156 / .3); border-radius: 7px; padding: 6px 12px; }

    .wrap { max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem 5rem; }

    .crumbs { font-size: .8rem; color: var(--text-tertiary); margin-bottom: 1.4rem; }
    .crumbs a { text-decoration: none; color: var(--text-secondary); }
    .crumbs a:hover { color: var(--accent); }
    .crumbs span { margin: 0 .4rem; }

    .head { border-left: 4px solid var(--accent); padding-left: 1.1rem; }
    .head .kicker { font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
    .head h1 { font-size: clamp(1.7rem, 5vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.08; margin-top: .35rem; }
    .head .lede { margin-top: 1rem; max-width: 60ch; color: var(--text-secondary); font-size: 1.05rem; }
    .head .intent { margin-top: .7rem; font-size: .9rem; color: var(--text-tertiary); }

    .stats { display: flex; flex-wrap: wrap; gap: 1.2rem 2.4rem; margin-top: 1.6rem;
      padding-top: 1.3rem; border-top: 1px solid var(--border); }
    .stat .n { font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; color: var(--accent); }
    .stat .l { font-size: .8rem; color: var(--text-tertiary); }

    /* cross-links to the other routes (internal linking) */
    .routes { margin-top: 1.8rem; }
    .routes-label { font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: .5rem; }
    .route-links { display: flex; flex-wrap: wrap; gap: .4rem; }
    .route-links a {
      font-size: .78rem; font-weight: 600; text-decoration: none; color: var(--text-secondary);
      border: 1px solid var(--border); background: var(--surface); padding: 5px 11px; border-radius: 999px; transition: all 120ms;
    }
    .route-links a:hover { border-color: var(--accent); color: var(--accent); }

    .cards { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    .card {
      display: block; text-decoration: none; background: var(--surface);
      border: 1px solid var(--border); border-radius: 11px; padding: .7rem .8rem;
      transition: border-color 140ms, transform 140ms;
      content-visibility: auto; contain-intrinsic-size: auto 96px;
    }
    .card:hover { border-color: var(--accent); transform: translateY(-1px); }
    .card-top { display: flex; align-items: baseline; gap: .5rem; }
    .jp { font-family: 'Noto Sans JP', sans-serif; font-weight: 700; font-size: 1.15rem; line-height: 1.2; }
    .reading { font-family: 'Noto Sans JP', sans-serif; font-size: .72rem; color: var(--text-tertiary); }
    .stub-dot { margin-left: auto; width: 7px; height: 7px; border-radius: 999px; flex: none;
      border: 1.5px solid var(--text-tertiary); align-self: center; }
    .card.written .stub-dot { background: var(--accent); border-color: var(--accent); }
    .meaning { font-size: .82rem; color: var(--text-secondary); margin-top: .25rem; line-height: 1.4;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .badges { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .5rem; }
    .badge {
      font-size: .64rem; font-weight: 600; letter-spacing: .02em; padding: 2px 6px; border-radius: 5px;
      background: var(--brand-tint); color: var(--text-secondary); border: 1px solid var(--border);
    }
    .badge.jlpt { color: #fff; border: none; }
    .badge.slug { font-family: ui-monospace, monospace; background: transparent; color: var(--text-tertiary); }

    /* ─── Start-here rail (the hero "next few steps") ─── */
    .rail { margin-top: 2.4rem; padding: 1.4rem 1.5rem 1.6rem; background: var(--tint);
      border: 1px solid var(--accent); border-radius: 16px; }
    .rail-kicker { display: inline-flex; align-items: center; gap: .4rem; font-size: .7rem; font-weight: 800;
      letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
    .rail-kicker svg { width: 14px; height: 14px; }
    .rail h2 { font-size: 1.25rem; font-weight: 800; letter-spacing: -.01em; margin-top: .5rem; }
    .rail p { color: var(--text-secondary); font-size: .9rem; margin-top: .25rem; max-width: 62ch; }
    .rail-steps { margin-top: 1.1rem; display: grid; gap: .55rem; }
    .step { display: flex; align-items: stretch; gap: .7rem; text-decoration: none; }
    .step-n { flex: none; width: 30px; display: grid; place-items: center; font-weight: 800; font-size: .9rem;
      color: var(--white); background: var(--accent); border-radius: 9px; }
    .step .card { flex: 1; }
    .step-1 .step-n { position: relative; }
    .start-flag { display: inline-block; margin-left: .5rem; font-size: .6rem; font-weight: 800; letter-spacing: .05em;
      text-transform: uppercase; color: var(--accent); background: var(--surface);
      border: 1px solid var(--accent); border-radius: 999px; padding: 1px 7px; vertical-align: middle; }
    .rail-more { margin-top: .9rem; font-size: .8rem; font-weight: 600; color: var(--accent); text-decoration: none; }
    .rail-more:hover { text-decoration: underline; }

    /* ─── Compact assumed spine (register goals only) ─── */
    .spine { margin-top: 2rem; padding: 1rem 1.2rem; background: var(--surface);
      border: 1px solid var(--border); border-radius: 12px; }
    .spine summary { cursor: pointer; font-size: .82rem; font-weight: 700; color: var(--text-secondary); }
    .spine summary::marker { color: var(--text-tertiary); }
    .spine .hint { font-weight: 400; color: var(--text-tertiary); }
    .spine-list { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .8rem; }
    .spine-list a { font-size: .76rem; text-decoration: none; color: var(--text-secondary);
      border: 1px solid var(--border); background: var(--bg); border-radius: 999px; padding: 3px 9px; }
    .spine-list a:hover { border-color: var(--accent); color: var(--accent); }

    /* ─── The numbered path (bands as subway stages) ─── */
    .path { margin-top: 2.8rem; }
    .path-head h2 { font-size: 1.3rem; font-weight: 800; letter-spacing: -.01em; }
    .path-head p { color: var(--text-secondary); font-size: .95rem; margin-top: .3rem; max-width: 62ch; }
    .band { position: relative; margin-top: 1.6rem; padding-left: 2.2rem; }
    .band::before { content: ""; position: absolute; left: 14px; top: -1.1rem; bottom: -1.1rem; width: 2px;
      background: var(--accent); opacity: .3; }
    .band:first-of-type::before { top: 1rem; }
    .band:last-of-type::before { bottom: auto; height: 1rem; }
    .band-label { position: relative; display: flex; align-items: center; gap: .6rem;
      font-size: .9rem; font-weight: 800; color: var(--text-primary); margin-bottom: .8rem; }
    .band-n { position: absolute; left: -2.2rem; top: 50%; transform: translateY(-50%);
      width: 30px; height: 30px; display: grid; place-items: center; font-size: .85rem; font-weight: 800;
      color: var(--white); background: var(--accent); border-radius: 999px; border: 3px solid var(--bg); }
    .band-count { font-size: .72rem; font-weight: 600; color: var(--text-tertiary); }

    /* ─── Everything-else family grid (read-novels rest) ─── */
    .catalog { margin-top: 3rem; }
    .catalog-head h2 { font-size: 1.3rem; font-weight: 800; letter-spacing: -.01em; }
    .catalog-head p { color: var(--text-secondary); font-size: .95rem; margin-top: .3rem; max-width: 60ch; }
    .family { margin-top: 2rem; }
    .family-label { display: flex; align-items: baseline; gap: .6rem;
      font-size: .95rem; font-weight: 700; color: var(--text-primary);
      padding-bottom: .5rem; border-bottom: 1px solid var(--border); margin-bottom: .9rem; }
    .family-label .count { font-size: .74rem; font-weight: 600; color: var(--text-tertiary); }

    .cta { margin-top: 3.5rem; padding: 1.8rem; background: var(--brand-dark); border-radius: 16px;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
    .cta-text h3 { color: var(--white); font-size: 1.15rem; font-weight: 800; }
    .cta-text p { color: oklch(99.5% 0.002 156 / .72); font-size: .9rem; margin-top: .3rem; max-width: 44ch; }
    .cta a { flex: none; font-size: .9rem; font-weight: 700; text-decoration: none; color: var(--brand-dark);
      background: var(--white); padding: 11px 20px; border-radius: 9px; }

    .empty-note { margin-top: 2rem; color: var(--text-secondary); font-size: .95rem; }
  </style>
</head>
<body style={`--accent:${goal.accent}; --tint:${goal.tint};`}>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-wordmark" href="/">Jengo</a>
      <a class="try" href="https://app.jengolang.com">Try Jengo</a>
    </div>
  </nav>

  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/learn/japanese">Japanese</a><span>›</span>
      <a href="/learn/japanese/grammar">Grammar</a><span>›</span>
      {goal.label}
    </nav>

    <header class="head">
      <div class="kicker">Goal route</div>
      <h1>{goal.h1}</h1>
      <p class="lede">{goal.lede}</p>
      <p class="intent">{goal.intent}</p>

      <div class="stats">
        <div class="stat"><div class="n">{total}</div><div class="l">grammar points on this route</div></div>
        <div class="stat"><div class="n">{writtenCount}</div><div class="l">with a full written guide</div></div>
      </div>
    </header>

    <section class="routes">
      <div class="routes-label">Other routes through the map</div>
      <div class="route-links">
        <a href="/learn/japanese/grammar">← Full grammar map</a>
        {others.map((g) => (
          <a href={`/learn/japanese/grammar/path/${g.id}`}>{g.label}</a>
        ))}
      </div>
    </section>

    {total === 0 ? (
      <p class="empty-note">No grammar points are tagged for this route yet.</p>
    ) : (
      <>
        {/* Hero: the next few steps, numbered, with a Start-here flag on #1 */}
        {rail.length > 0 && (
          <section class="rail" aria-label="Start here">
            <span class="rail-kicker">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              Your route
            </span>
            <h2>Start here</h2>
            <p>
              {bandMode === "band0"
                ? "Begin at the foundations — the trunk every route shares. Work down in order; each step builds on the last."
                : `${goal.label} assumes the foundations below. Start with these — they're ordered most-useful-first.`}
            </p>
            <div class="rail-steps">
              {rail.map((n, i) => (
                <a class={`step step-${i + 1}`} href={`/learn/japanese/grammar/${n.slug}`}>
                  <span class="step-n">{i + 1}</span>
                  <span class={`card${n.written ? " written" : ""}`}>
                    <div class="card-top">
                      <span class="jp">{n.canonical}</span>
                      <span class="reading">{n.reading}</span>
                      {i === 0 && <span class="start-flag">Start</span>}
                      <span class="stub-dot"></span>
                    </div>
                    <div class="meaning">{n.gloss}</div>
                  </span>
                </a>
              ))}
            </div>
            <a class="rail-more" href="#path">See the full route ↓</a>
          </section>
        )}

        {/* Register goals: the trunk is prerequisite, shown compact, not numbered */}
        {bandMode === "spine" && (
          <details class="spine">
            <summary>Foundations — the shared spine <span class="hint">· assumed by this route, start here if you're new</span></summary>
            <div class="spine-list">
              {foundationNodes.map((n) => (
                <a href={`/learn/japanese/grammar/${n.slug}`}>{n.canonical}</a>
              ))}
            </div>
          </details>
        )}

        {/* The numbered path: bands as subway stages */}
        <section class="path" id="path">
          <div class="path-head">
            <h2>The full route</h2>
            <p>
              {pathBands.length} stage{pathBands.length === 1 ? "" : "s"}, ordered so each builds on the last.
              A <strong>filled dot</strong> marks a point with a full written guide; hollow dots are mapped,
              their guide still being written.
            </p>
          </div>
          {pathBands.map((b, i) => (
            <div class="band">
              <div class="band-label">
                <span class="band-n">{i + 1}</span>
                {b.label}
                <span class="band-count">{b.nodes.length} point{b.nodes.length === 1 ? "" : "s"}</span>
              </div>
              <div class="cards">
                {b.nodes.map((n) => (
                  <a class={`card${n.written ? " written" : ""}`} href={`/learn/japanese/grammar/${n.slug}`}>
                    <div class="card-top"><span class="jp">{n.canonical}</span><span class="reading">{n.reading}</span><span class="stub-dot"></span></div>
                    <div class="meaning">{n.gloss}</div>
                    <div class="badges">
                      <span class="badge jlpt" style={`background:${jlptColor[n.jlpt] ?? jlptColor.none}`}>{n.jlpt}</span>
                      <span class="badge">{n.family}</span>
                      <span class="badge slug">{n.slug}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </section>

        {/* read-novels: literary points beyond the curated route */}
        {restGroups.length > 0 && (
          <section class="catalog">
            <div class="catalog-head">
              <h2>Every other literary &amp; classical point</h2>
              <p>
                {restNodes.length} more grammar point{restNodes.length === 1 ? "" : "s"} in the literary set,
                beyond the core route above — grouped by family for reference.
              </p>
            </div>
            {restGroups.map((g) => (
              <div class="family" data-family={g.key}>
                <div class="family-label">{g.label}<span class="count">{g.nodes.length}</span></div>
                <div class="cards">
                  {g.nodes.map((n) => (
                    <a class={`card${n.written ? " written" : ""}`} href={`/learn/japanese/grammar/${n.slug}`}>
                      <div class="card-top"><span class="jp">{n.canonical}</span><span class="reading">{n.reading}</span><span class="stub-dot"></span></div>
                      <div class="meaning">{n.gloss}</div>
                      <div class="badges">
                        <span class="badge jlpt" style={`background:${jlptColor[n.jlpt] ?? jlptColor.none}`}>{n.jlpt}</span>
                        <span class="badge">{n.freq}</span>
                        <span class="badge slug">{n.slug}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )}
      </>
    )}

    <section class="cta">
      <div class="cta-text">
        <h3>Practice this grammar in context</h3>
        <p>Jengo shows these patterns inside real sentences, so they stick as comprehension — not flashcards.</p>
      </div>
      <a href="https://app.jengolang.com">Try Jengo</a>
    </section>
  </main>
</body>
</html>
