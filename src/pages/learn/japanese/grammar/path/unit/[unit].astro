---
import { getCollection } from "astro:content";
import GrammarModeSwitcher from "../../../../../../components/GrammarModeSwitcher.astro";
import GrammarShell from "../../../../../../components/GrammarShell.astro";
import slice from "../../../../../../data/grammar_slice.json";
export const prerender=true;
export async function getStaticPaths(){return slice.spine.arcs.flatMap((arc)=>arc.units.map((unit)=>({params:{unit:String(unit.index)},props:{arc,unit}})))}
const {arc,unit}=Astro.props;
const units=slice.spine.arcs.flatMap((item)=>item.units.map((child)=>({arc:item,unit:child})));
const previous=units.find((item)=>item.unit.index===unit.index-1);
const next=units.find((item)=>item.unit.index===unit.index+1);
const entries=await getCollection("grammar");const meta=new Map(entries.map((e)=>[e.id,e.data]));
const nodes=unit.nodes.map((n)=>({...n,written:!meta.get(n.slug)?.noindex,keigo:n.keigo!=="none",literary:String(n.register).includes("literary")||String(n.register).includes("archaic")}));
const hasKanji=(value)=>/[\u3400-\u9fff々〆ヶ]/.test(value);
const title=`${unit.label} — Japanese Grammar Path | Jengo`;const description=`Unit ${unit.index} of the Jengo Japanese grammar path: ${unit.label}. ${nodes.length} ordered grammar points.`;
---
<GrammarShell title={title} description={description} canonical={`https://jengolang.com/learn/japanese/grammar/path/unit/${unit.index}`}>
  <main class="grammar-wrap">
    <a class="back-path" href="/learn/japanese/grammar/path" aria-label="Back to grammar Path"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg><span>Path</span></a>
    <GrammarModeSwitcher mode="path" />
    <nav class="crumb">Arc {arc.index}<span>/</span>Unit {unit.index}</nav>
    <header class="unit-head"><small>Unit {unit.index} · Arc {arc.index}</small><h1>{unit.label}</h1><div class="unit-summary"><span><strong id="done">0</strong> of {nodes.length} learned</span></div><div class="bar"><i id="bar"></i></div></header>
    <div class="nodes">
      {nodes.map((n)=><article class:list={["node",{stub:!n.written}]} data-slug={n.slug}>
        <button class="check" type="button" aria-label={`Mark ${n.canonical} learned`} aria-pressed="false"><svg viewBox="0 0 24 24"><path d="m20 6-11 11-5-5"/></svg></button>
        <a href={`/learn/japanese/grammar/${n.slug}`}><span class="canonical">{hasKanji(n.canonical)&&n.reading!==n.canonical?<ruby>{n.canonical}<rt>{n.reading}</rt></ruby>:n.canonical}</span><span class="gloss">{n.meaning}</span></a>
        <div class="tags"><span class="jlpt" data-level={n.jlpt}>{n.jlpt}</span>{n.keigo&&<span class="tag keigo">keigo</span>}{n.literary&&<span class="tag literary">literary</span>}{!n.written&&<span class="coverage">guide in progress</span>}</div>
      </article>)}
    </div>
    <button id="mark-all" class="complete-unit" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg><span>Mark unit learned</span></button>
    <footer>{previous?<a href={`/learn/japanese/grammar/path/unit/${previous.unit.index}`}>← Previous unit</a>:<span></span>}{next&&<a href={`/learn/japanese/grammar/path/unit/${next.unit.index}`}>Next unit →</a>}</footer>
  </main>
  <script>
    import {connectProgress,isLearned as isNodeLearned,loadProgress,saveProgress,setLearned} from "../../../../../../lib/progress";
    let state=loadProgress();
    const cards=[...document.querySelectorAll(".node")];const isLearned=(s)=>isNodeLearned(state,s);
    function render(){let n=0;cards.forEach((card)=>{const on=isLearned(card.dataset.slug);n+=on;card.classList.toggle("learned",on);card.querySelector(".check").setAttribute("aria-pressed",String(on))});document.querySelector("#done").textContent=n;document.querySelector("#bar").style.width=`${Math.round(n/cards.length*100)}%`;const button=document.querySelector("#mark-all");button.classList.toggle("learned",n===cards.length);button.querySelector("span").textContent=n===cards.length?"Unit learned · tap to undo":"Mark unit learned"}
    cards.forEach((card)=>card.querySelector(".check").addEventListener("click",()=>{const slug=card.dataset.slug;setLearned(state,slug,!isLearned(slug));saveProgress(state,[slug]);render()}));
    document.querySelector("#mark-all").addEventListener("click",()=>{const clear=cards.every((c)=>isLearned(c.dataset.slug));const slugs=cards.map((c)=>c.dataset.slug);slugs.forEach((slug)=>setLearned(state,slug,!clear));saveProgress(state,slugs);render()});connectProgress((next)=>{state=next;render()});render();
  </script>
</GrammarShell>
<style>
  .back-path{display:inline-flex;align-items:center;gap:3px;margin:0 0 18px -6px;color:var(--text-secondary);font-size:.8rem;font-weight:700;text-decoration:none}.back-path:hover{color:var(--brand)}.back-path svg{width:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.crumb{display:flex;gap:8px;margin-top:24px;color:var(--text-tertiary);font-size:.75rem}.unit-head{margin-top:20px}.unit-head>small{font-size:.7rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-tertiary)}h1{margin-top:4px;font-size:1.8rem;line-height:1.18;letter-spacing:-.02em}.unit-summary{margin-top:20px;color:var(--text-secondary);font-size:.82rem}.unit-summary strong{color:var(--text-primary)}.bar{height:5px;margin-top:8px;border-radius:99px;overflow:hidden;background:oklch(91% .008 156)}.bar i{display:block;width:0;height:100%;background:var(--learned);transition:width .2s ease-out}.nodes{margin-top:24px;border-top:1px solid var(--border)}.node{display:grid;grid-template-columns:28px 1fr;gap:4px 12px;padding:14px 4px;border-bottom:1px solid var(--border)}.check{grid-row:1/3;width:22px;height:22px;margin-top:2px;border:1.5px solid var(--border-strong);border-radius:6px;background:transparent;cursor:pointer}.check svg{width:13px;fill:none;stroke:transparent;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}.node.learned .check{border-color:var(--learned);background:var(--learned)}.node.learned .check svg{stroke:var(--white)}.node>a{display:grid;gap:2px;text-decoration:none}.canonical{font-family:"Noto Sans JP",sans-serif;font-size:1.05rem;font-weight:600;line-height:1.8}.canonical rt{font-size:.52em;font-weight:500;color:var(--text-tertiary)}.gloss{color:var(--text-secondary);font-size:.8rem}.tags{grid-column:2;display:flex;align-items:center;gap:5px;margin-top:4px}.jlpt,.tag{padding:2px 6px;border-radius:5px;color:var(--white);font-size:.6rem;font-weight:700}.jlpt[data-level="N5"]{background:oklch(55% .10 156)}.jlpt[data-level="N4"]{background:oklch(55% .10 200)}.jlpt[data-level="N3"]{background:oklch(55% .11 250)}.jlpt[data-level="N2"]{background:oklch(52% .12 300)}.jlpt[data-level="N1"]{background:oklch(50% .13 340)}.jlpt[data-level="none"]{background:oklch(60% .01 156)}.tag.keigo{background:var(--keigo)}.tag.literary{background:var(--literary)}.coverage{margin-left:auto;color:var(--text-tertiary);font-size:.63rem}.stub .canonical{color:var(--text-secondary)}.complete-unit{width:100%;min-height:50px;margin-top:28px;display:flex;align-items:center;justify-content:center;gap:9px;border:1px solid color-mix(in oklab,var(--brand) 28%,var(--border));border-radius:10px;background:var(--brand-tint);color:var(--brand);font-weight:700;cursor:pointer}.complete-unit svg{width:18px;fill:none;stroke:currentColor;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round}.complete-unit.learned{border-color:var(--learned);background:var(--learned);color:var(--white)}footer{display:flex;justify-content:space-between;margin-top:28px}footer a{color:var(--brand);font-size:.8rem;font-weight:700;text-decoration:none}
  @media(min-width:640px){h1{font-size:2.15rem}.node{grid-template-columns:28px 1fr auto}.tags{grid-column:3;grid-row:1/3;margin:0}.coverage{margin-left:6px}.node>a{grid-template-columns:170px 1fr;align-items:center;gap:12px}}
</style>
