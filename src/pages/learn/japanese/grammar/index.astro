---
import { getCollection } from "astro:content";
import GrammarModeSwitcher from "../../../../components/GrammarModeSwitcher.astro";
import GrammarShell from "../../../../components/GrammarShell.astro";
import { glossOf } from "../../../../lib/grammar";

export const prerender = true;
const entries = await getCollection("grammar");
const rows = entries.filter((e) => !e.data.foldInto).map((e) => ({
  slug:e.id, canonical:e.data.canonical, reading:e.data.reading, romaji:e.id.replaceAll("-"," "),
  gloss:glossOf(e.data), jlpt:e.data.jlpt, freq:e.data.freq, family:e.data.family,
  keigo:e.data.keigo !== "none", literary:e.data.register.includes("literary") || e.data.register.includes("archaic"),
  written:!e.data.noindex,
}));
const title="Japanese Grammar Lookup — Jengo";
const description="Search 1,458 Japanese grammar points by romaji, kana, kanji, or English. Browse JLPT level, frequency, keigo, and literary grammar.";
---
<GrammarShell title={title} description={description} canonical="https://jengolang.com/learn/japanese/grammar">
  <main class="grammar-wrap">
    <GrammarModeSwitcher mode="lookup" />
    <h1 class="sr-only">Grammar Dictionary</h1>

    <div class="search-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="grammar-search" type="search" autocomplete="off" placeholder={`Search ${rows.length.toLocaleString()} grammar points`} aria-label="Search Japanese grammar" />
      <button id="filters-button" class="filters-button" type="button" aria-expanded="false" aria-controls="filter-menu" aria-label="Filter results">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 3H2l8 9.5V19l4 2v-8.5L22 3Z"/></svg><span id="filter-count"></span>
      </button>
      <div id="filter-menu" class="filter-menu" hidden>
        <strong>Filter by tag</strong>
        <label><input type="checkbox" value="keigo" /> <span>Keigo</span><i class="keigo"></i></label>
        <label><input type="checkbox" value="literary" /> <span>Literary</span><i class="literary"></i></label>
        <button id="clear-filters" type="button">Clear all filters</button>
      </div>
    </div>

    <div class="result-head"><strong id="result-count">{rows.length.toLocaleString()} points</strong><span>↑↓ to move · ↵ to open</span></div>
    <div id="results" class="results" aria-live="polite"></div>
    <button id="show-more" class="show-more" type="button" hidden>Show more</button>
    <noscript><p class="noscript">Search needs JavaScript. You can still browse the <a href="/learn/japanese/grammar/path">grammar path</a>.</p></noscript>
  </main>
  <script id="grammar-data" type="application/json" set:html={JSON.stringify(rows).replaceAll("<", "\\u003c")} />
  <script>
    const data = JSON.parse(document.querySelector("#grammar-data").textContent);
    const search = document.querySelector("#grammar-search");
    const results = document.querySelector("#results");
    const count = document.querySelector("#result-count");
    const more = document.querySelector("#show-more");
    const filterButton = document.querySelector("#filters-button");
    const filterMenu = document.querySelector("#filter-menu");
    const filterCount = document.querySelector("#filter-count");
    let limit = 60, active = -1;
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    const term = (n) => /[\u3400-\u9fff々〆ヶ]/.test(n.canonical) && n.reading && n.reading !== n.canonical
      ? `<ruby><rb>${esc(n.canonical)}</rb><rt>${esc(n.reading)}</rt></ruby>`
      : esc(n.canonical);
    const colors = {N5:"oklch(55% .10 156)",N4:"oklch(55% .10 200)",N3:"oklch(55% .11 250)",N2:"oklch(52% .12 300)",N1:"oklch(50% .13 340)",none:"oklch(60% .01 156)"};
    function filtered(){
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const tags = [...filterMenu.querySelectorAll("input:checked")].map((x) => x.value);
      return data.filter((n) => terms.every((t) => `${n.canonical} ${n.reading} ${n.romaji} ${n.gloss}`.toLowerCase().includes(t)) && (!tags.length || tags.some((t) => n[t])));
    }
    function render(reset=false){
      if(reset) limit=60;
      const found=filtered(); active=-1;
      count.textContent=`${found.length.toLocaleString()} ${found.length===1?"point":"points"}`;
      results.innerHTML=found.slice(0,limit).map((n) => `<a class="result ${n.written?"":"stub"}" href="/learn/japanese/grammar/${encodeURIComponent(n.slug)}"><span class="jp">${term(n)}</span><span class="gloss">${esc(n.gloss)}</span><span class="freq ${esc(n.freq)}">${esc(n.freq)}</span><span class="jlpt" style="--level:${colors[n.jlpt]||colors.none}">${esc(n.jlpt)}</span></a>`).join("") || `<div class="empty"><strong>No points match that.</strong><span>Try a shorter term, a romaji spelling, or clear the filters.</span></div>`;
      more.hidden=found.length<=limit;
      filterCount.textContent=[...filterMenu.querySelectorAll("input:checked")].length||"";
      filterButton.classList.toggle("filtered",!!filterCount.textContent);
    }
    function move(delta){const links=[...results.querySelectorAll("a")];if(!links.length)return;active=Math.max(0,Math.min(links.length-1,active+delta));links[active].focus();}
    search.addEventListener("input",()=>render(true));
    search.addEventListener("keydown",(e)=>{if(e.key==="ArrowDown"){e.preventDefault();move(1)}else if(e.key==="ArrowUp"){e.preventDefault();move(-1)}else if(e.key==="Enter"&&active>=0){results.querySelectorAll("a")[active]?.click()}});
    filterButton.addEventListener("click",()=>{filterMenu.hidden=!filterMenu.hidden;filterButton.setAttribute("aria-expanded",String(!filterMenu.hidden))});
    filterMenu.addEventListener("change",()=>render(true));
    document.querySelector("#clear-filters").addEventListener("click",()=>{filterMenu.querySelectorAll("input").forEach((x)=>x.checked=false);render(true)});
    more.addEventListener("click",()=>{limit+=60;render()});
    render();
  </script>
</GrammarShell>

<style is:global>
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.search-wrap{position:relative;margin-top:16px}.search-icon{position:absolute;left:17px;top:18px;width:20px;fill:none;stroke:var(--text-tertiary);stroke-width:2;stroke-linecap:round}.search-wrap>input{width:100%;height:56px;padding:0 58px 0 49px;border:1.5px solid var(--border-strong);border-radius:12px;background:var(--surface);color:var(--text-primary);font-size:1rem}.search-wrap>input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px oklch(47% .089 156/.1)}
  .filters-button{position:absolute;right:9px;top:9px;width:38px;height:38px;display:grid;place-items:center;border:0;border-radius:9px;background:transparent;color:var(--text-secondary);cursor:pointer}.filters-button:hover{background:var(--brand-tint)}.filters-button.filtered{background:var(--brand);color:var(--white)}.filters-button svg{width:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linejoin:round}.filters-button span:not(:empty){position:absolute;right:3px;top:2px;font-size:.62rem;font-weight:800}
  .filter-menu{position:absolute;z-index:10;right:0;top:64px;width:250px;padding:8px;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:0 16px 40px -18px oklch(30% .03 156/.45)}.filter-menu strong{display:block;padding:6px 10px;font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;color:var(--text-tertiary)}.filter-menu label{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:.82rem;font-weight:600}.filter-menu label:hover{background:var(--brand-tint)}.filter-menu label span{flex:1}.filter-menu i{width:8px;height:8px;border-radius:50%}.filter-menu i.keigo{background:var(--keigo)}.filter-menu i.literary{background:var(--literary)}.filter-menu button{margin-top:5px;padding:8px 10px;border:0;border-top:1px solid var(--border);width:100%;background:none;text-align:left;color:var(--text-secondary);font-size:.75rem;font-weight:600;cursor:pointer}
  .result-head{display:flex;justify-content:space-between;align-items:baseline;margin-top:22px;padding-bottom:10px;border-bottom:1px solid var(--border)}.result-head strong{font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:var(--text-secondary)}.result-head span{font-size:.7rem;color:var(--text-tertiary)}
  .result{display:grid;grid-template-columns:minmax(108px,1fr) auto;gap:5px 12px;align-items:center;padding:14px 8px;border-bottom:1px solid oklch(93% .005 156);border-radius:8px;text-decoration:none}.result:hover,.result:focus{background:var(--brand-tint);outline:none}.jp{font-family:"Noto Sans JP",sans-serif;font-size:1.08rem;font-weight:600;line-height:1.8}.jp rt{font-size:.55em;font-weight:500;color:var(--text-tertiary)}.gloss{grid-column:1;color:var(--text-secondary);font-size:.84rem}.freq{display:none}.jlpt{grid-column:2;grid-row:1/3;padding:2px 6px;border-radius:5px;background:var(--level);color:var(--white);font-size:.64rem;font-weight:700}.result.stub .jp{color:var(--text-secondary)}.result.stub::after{content:"Guide in progress";display:none}.empty{display:grid;gap:4px;padding:42px 20px;text-align:center;color:var(--text-secondary)}.empty strong{color:var(--text-primary)}.empty span{font-size:.85rem}.show-more{display:block;margin:24px auto 0;padding:9px 18px;border:1px solid var(--border-strong);border-radius:8px;background:var(--surface);color:var(--text-secondary);font-weight:600;cursor:pointer}.noscript{margin-top:24px;color:var(--text-secondary)}
  @media(min-width:640px){.result{grid-template-columns:180px 1fr 74px 36px}.gloss{grid-column:2;grid-row:1}.freq{display:block;grid-column:3;font-size:.7rem;font-weight:600;color:var(--text-tertiary)}.freq.essential{color:var(--brand);font-weight:700}.jlpt{grid-column:4;grid-row:1}}
</style>
