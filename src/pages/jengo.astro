---
const title = "Jengo — Between a reader and a flashcard app. Better than both.";
const description = "Jengo takes your vocabulary review list and generates it into a paragraph. Read, tap what you don't know, and submit. Words land in context and stick.";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;800&family=Noto+Sans+JP:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --brand:          oklch(47% 0.089 156);
      --brand-dark:     oklch(25% 0.062 156);
      --brand-tint:     oklch(96% 0.016 156);
      --bg:             oklch(98.5% 0.005 156);
      --surface:        oklch(99% 0.003 156);
      --border:         oklch(90% 0.008 156);
      --text-primary:   oklch(22% 0.010 156);
      --text-secondary: oklch(50% 0.012 156);
      --text-tertiary:  oklch(68% 0.008 156);
      --white:          oklch(99.5% 0.002 156);
      --ease-out:       cubic-bezier(0.16, 1, 0.3, 1);
    }

    html { font-optical-sizing: auto; scroll-behavior: smooth; }
    body {
      font-family: 'Onest', system-ui, sans-serif;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text-primary);
      background: var(--bg);
      -webkit-font-smoothing: antialiased;
    }
    img { display: block; max-width: 100%; }
    a { color: inherit; }
    h1, h2, h3 { text-wrap: balance; }
    p { text-wrap: pretty; }

    /* ─── Nav ─────────────────────────────────────── */

    .nav {
      background: var(--brand-dark);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-inner {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }
    .nav-logo-mark { width: 26px; height: 26px; border-radius: 5px; }
    .nav-wordmark {
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      letter-spacing: -0.01em;
    }
    .nav-links {
      display: none;
      list-style: none;
      gap: 1.5rem;
    }
    @media (min-width: 600px) { .nav-links { display: flex; } }
    .nav-links a {
      font-size: 0.875rem;
      font-weight: 500;
      color: oklch(99.5% 0.002 156 / 0.6);
      text-decoration: none;
      transition: color 140ms;
    }
    .nav-links a:hover { color: var(--white); }
    .nav-cta {
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      color: oklch(99.5% 0.002 156 / 0.65);
      background: none;
      border: none;
      text-decoration: none;
      cursor: pointer;
      transition: color 140ms;
    }
    .nav-cta:hover { color: var(--white); }

    /* ─── Shared helpers ──────────────────────────── */

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: inherit;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--white);
      background: var(--brand);
      border: none;
      border-radius: 8px;
      padding: 11px 24px;
      text-decoration: none;
      cursor: pointer;
      transition: background 140ms var(--ease-out);
      white-space: nowrap;
    }
    .btn-primary:hover { background: oklch(42% 0.089 156); }

    .appstore-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-radius: 8px;
      padding: 9px 16px;
      text-decoration: none;
      transition: background 140ms var(--ease-out);
      white-space: nowrap;
    }
    .appstore-btn-dark {
      background: oklch(99.5% 0.002 156 / 0.08);
      border: 1.5px solid oklch(99.5% 0.002 156 / 0.2);
    }
    .appstore-btn-dark:hover { background: oklch(99.5% 0.002 156 / 0.14); }
    .appstore-btn-light {
      background: transparent;
      border: 1.5px solid var(--border);
    }
    .appstore-btn-light:hover { background: oklch(94% 0.01 156); }
    .appstore-btn-text { display: flex; flex-direction: column; line-height: 1.1; }
    .appstore-btn-sub {
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.01em;
    }
    .appstore-btn-label { font-size: 0.875rem; font-weight: 600; }
    .appstore-btn-dark .appstore-btn-sub   { color: oklch(99.5% 0.002 156 / 0.55); }
    .appstore-btn-dark .appstore-btn-label { color: var(--white); }
    .appstore-btn-light .appstore-btn-sub   { color: var(--text-tertiary); }
    .appstore-btn-light .appstore-btn-label { color: var(--text-primary); }

    /* ─── Hero ────────────────────────────────────── */

    .hero {
      background: var(--brand-dark);
      padding: 5rem 1.5rem 4.5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero-inner {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      position: relative;
      z-index: 1;
    }
    .hero-heading {
      font-size: clamp(2.125rem, 1.5rem + 3vw, 3.75rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.1;
      color: var(--white);
    }
    .hero-heading em {
      font-style: normal;
      color: oklch(78% 0.19 50);
    }
    .hero-sub {
      font-size: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
      color: oklch(78% 0.014 156);
      max-width: 38ch;
      line-height: 1.6;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
      justify-content: center;
    }
    .hero-platforms {
      font-size: 0.8125rem;
      color: oklch(60% 0.08 156);
      font-weight: 500;
    }

    /* Generating background */
    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-char {
      position: absolute;
      left: var(--x);
      top: var(--y);
      font-size: var(--s);
      font-family: 'Noto Sans JP', sans-serif;
      font-weight: 500;
      color: var(--white);
      opacity: 0;
      animation: charPulse var(--dur) var(--del) infinite;
    }
    @keyframes charPulse {
      0%, 100%  { opacity: 0; }
      25%, 75%  { opacity: var(--op); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-char { display: none; }
    }

    /* ─── Devices ─────────────────────────────────── */

    .devices {
      background: var(--bg);
      padding: 4rem 1.5rem;
      overflow: hidden;
    }
    .devices-inner {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 2rem;
    }

    /* Phone device frame */
    .phone-device {
      width: 180px;
      flex-shrink: 0;
      background: oklch(18% 0.005 270);
      border-radius: 32px;
      padding: 8px;
      box-shadow:
        0 0 0 1px oklch(40% 0.005 270),
        0 20px 60px oklch(0% 0 0 / 0.18);
    }
    .phone-device-screen {
      background: var(--surface);
      border-radius: 25px;
      overflow: hidden;
      aspect-ratio: 9 / 19.5;
      display: flex;
      align-items: flex-start;
    }
    .phone-device-screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      display: block;
    }
    .phone-device-placeholder {
      width: 100%;
      height: 100%;
      background: var(--brand-tint);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .phone-device-placeholder span {
      font-size: 0.6rem;
      color: var(--brand);
      font-weight: 600;
      text-align: center;
      padding: 0.5rem;
      line-height: 1.4;
    }

    /* Browser/desktop device frame */
    .browser-device {
      flex: 1;
      min-width: 0;
      max-width: 560px;
      background: oklch(20% 0.005 270);
      border-radius: 10px;
      overflow: hidden;
      box-shadow:
        0 0 0 1px oklch(38% 0.005 270),
        0 20px 60px oklch(0% 0 0 / 0.14);
    }
    .browser-bar {
      background: oklch(24% 0.005 270);
      height: 30px;
      display: flex;
      align-items: center;
      padding: 0 10px;
      gap: 5px;
    }
    .browser-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .browser-dot-red   { background: #ff5f57; }
    .browser-dot-yel   { background: #febc2e; }
    .browser-dot-grn   { background: #28c840; }
    .browser-url {
      margin-left: 8px;
      background: oklch(30% 0.005 270);
      border-radius: 5px;
      height: 18px;
      flex: 1;
      max-width: 220px;
      display: flex;
      align-items: center;
      padding: 0 8px;
      gap: 4px;
    }
    .browser-url-text {
      font-size: 0.625rem;
      color: oklch(65% 0.005 270);
    }
    .browser-screen {
      background: var(--surface);
      overflow: hidden;
      aspect-ratio: 2412 / 1424;
    }
    .browser-screen img {
      width: 100%;
      height: auto;
      display: block;
    }
    .browser-screen-placeholder {
      width: 100%;
      height: 100%;
      background: var(--brand-tint);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .browser-screen-placeholder span {
      font-size: 0.7rem;
      color: var(--brand);
      font-weight: 600;
      text-align: center;
      padding: 1rem;
    }

    @media (max-width: 600px) {
      .browser-device { display: none; }
      .phone-device { width: 200px; }
    }

    /* ─── Demo ────────────────────────────────────── */

    .demo {
      background: var(--brand-dark);
      padding: 5rem 1.5rem;
    }
    .demo-header {
      text-align: center;
      max-width: 480px;
      margin: 0 auto 2.5rem;
    }
    .demo-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: oklch(65% 0.09 156);
      margin-bottom: 0.75rem;
    }
    .demo-heading {
      font-size: clamp(1.75rem, 1.3rem + 2.2vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.1;
      color: var(--white);
    }
    .demo-sub {
      font-size: 1rem;
      color: oklch(72% 0.012 156);
      margin-top: 0.75rem;
      line-height: 1.6;
    }

    .demo-widget { max-width: 480px; margin: 0 auto; }

    /* Due chips */
    .demo-due-bar { margin-bottom: 0.75rem; }
    .demo-due-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: oklch(60% 0.08 156);
      margin-bottom: 0.375rem;
    }
    .demo-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      min-height: 1.9rem;
    }

    @keyframes chipIn {
      from { opacity: 0; transform: scale(0.82) translateY(4px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    .demo-chip {
      display: inline-block;
      padding: 0.2rem 0.65rem;
      background: oklch(99.5% 0.002 156 / 0.92);
      border-radius: 20px;
      color: oklch(25% 0.062 156);
      font-size: 1rem;
      font-weight: 600;
      font-family: 'Noto Sans JP', sans-serif;
      opacity: 0;
      animation: chipIn 0.28s var(--ease-out) forwards;
    }

    /* Para frame */
    .demo-frame {
      background: oklch(0% 0 0 / 0.18);
      border-radius: 10px;
      padding: 1rem 1.1rem;
      border: 1px solid oklch(99.5% 0.002 156 / 0.12);
      position: relative;
    }
    .demo-para {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 1.25rem;
      line-height: 2.1;
      letter-spacing: 0.01em;
      color: var(--white);
      word-break: break-word;
      height: 9.5rem; /* fixed — prevents layout shift during typewriter */
      overflow: hidden;
    }

    /* Animated cursor */
    .demo-cursor {
      position: absolute;
      pointer-events: none;
      z-index: 20;
      opacity: 0;
      transition: left 0.42s var(--ease-out), top 0.42s var(--ease-out), opacity 0.2s;
      filter: drop-shadow(0 1px 2px oklch(0% 0 0 / 0.4));
    }
    .demo-cursor.visible { opacity: 1; }

    .demo-word {
      border-radius: 3px;
      padding: 0 1px;
      transition: background 0.18s, color 0.18s;
      display: inline;
    }
    .demo-word-known    { color: oklch(72% 0.12 156); }
    .demo-word-selected { background: #ffe58a; color: #1a1a1a; }

    /* Dictionary panel — lives in a pre-reserved slot so it never shifts layout */
    .demo-dict-slot {
      height: 140px;
      padding-top: 0.875rem;
      border-top: 1px solid oklch(99.5% 0.002 156 / 0.15);
      margin-top: 0.875rem;
      overflow: hidden;
    }
    .demo-dict {
      opacity: 0;
      border-radius: 8px;
      padding: 0.875rem 1rem;
      transition: opacity 0.25s var(--ease-out);
    }
    .demo-dict.visible {
      opacity: 1;
      background: oklch(57% 0.148 50);
      border: none;
    }
    .demo-dict.visible .demo-dict-surface,
    .demo-dict.visible .demo-dict-reading,
    .demo-dict.visible .demo-dict-pos,
    .demo-dict.visible .demo-dict-meanings { color: oklch(98% 0.03 50); }
    .demo-dict-head {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.25rem;
    }
    .demo-dict-surface {
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--white);
    }
    .demo-dict-reading { font-size: 0.8rem; color: oklch(65% 0.01 156); }
    .demo-dict-pos {
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: oklch(55% 0.06 156);
      margin-bottom: 0.375rem;
    }
    .demo-dict-meanings {
      margin: 0;
      padding-left: 1.1rem;
      font-size: 0.875rem;
      color: oklch(82% 0.01 156);
      line-height: 1.6;
    }

    /* Submit button */
    .demo-submit {
      display: block;
      width: 100%;
      margin-top: 1rem;
      font-family: inherit;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--white);
      background: var(--brand);
      border: none;
      border-radius: 8px;
      padding: 11px;
      cursor: default;
      opacity: 0.3;
      transition: background 140ms var(--ease-out), opacity 0.3s, transform 0.1s;
    }
    .demo-submit.ready { opacity: 1; }
    .demo-submit.fire  { background: oklch(54% 0.089 156); transform: scale(0.97); }

    /* ─── Showcase (alternating) ─────────────────── */

    .showcase {
      background: var(--surface);
      padding: 5rem 1.5rem;
      border-top: 1px solid var(--border);
    }
    .showcase-inner {
      max-width: 1040px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 5rem;
    }
    .showcase-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .showcase-row--flip .showcase-img { order: 2; }
    .showcase-row--flip .showcase-text { order: 1; }
    @media (max-width: 680px) {
      .showcase-row {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .showcase-row--flip .showcase-img { order: 0; }
      .showcase-row--flip .showcase-text { order: 1; }
    }
    .showcase-img {
      display: flex;
      justify-content: center;
    }
    .showcase-phone {
      width: 220px;
      background: oklch(18% 0.005 270);
      border-radius: 36px;
      padding: 9px;
      box-shadow:
        0 0 0 1px oklch(40% 0.005 270),
        0 24px 64px oklch(0% 0 0 / 0.14);
    }
    .showcase-phone-screen {
      background: var(--surface);
      border-radius: 28px;
      overflow: hidden;
      aspect-ratio: 9 / 19.5;
    }
    .showcase-phone-screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      display: block;
    }
    .showcase-text {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .showcase-label {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--brand);
    }
    .showcase-heading {
      font-size: clamp(1.5rem, 1.1rem + 2vw, 2.125rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: var(--text-primary);
    }
    .showcase-body {
      font-size: 1.0625rem;
      color: var(--text-secondary);
      line-height: 1.75;
      max-width: 42ch;
    }
    .showcase-divider {
      border: none;
      border-top: 1px solid var(--border);
    }

    /* ─── Secondary CTA ───────────────────────────── */

    .cta {
      background: var(--brand-tint);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 4rem 1.5rem;
      text-align: center;
    }
    .cta-inner {
      max-width: 480px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }
    .cta-heading {
      font-size: clamp(1.5rem, 1.1rem + 2vw, 2.125rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.1;
      color: var(--text-primary);
    }
    .cta-sub {
      font-size: 0.9375rem;
      color: var(--text-secondary);
    }
    .cta-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
      justify-content: center;
    }

    /* ─── Creator ─────────────────────────────────── */

    .creator {
      background: var(--bg);
      padding: 5rem 1.5rem;
    }
    .creator-inner {
      max-width: 760px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 200px;
      gap: 3rem;
      align-items: center;
    }
    @media (max-width: 560px) {
      .creator-inner { grid-template-columns: 1fr; justify-items: center; }
      .creator-photo { width: 220px; height: 220px; order: 0; }
      .creator-content { order: 1; width: 100%; }
    }
    .creator-photo {
      width: 200px;
      height: 200px;
      border-radius: 14px;
      object-fit: cover;
      object-position: 50% 22%;
      border: 1px solid var(--border);
      order: 2;
    }
    .creator-content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      order: 1;
    }
    .creator-label {
      font-size: clamp(1.75rem, 1.3rem + 2.2vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.1;
      color: var(--text-primary);
    }
    .creator-body {
      font-size: 1.0625rem;
      color: var(--text-secondary);
      line-height: 1.75;
    }
    /* ─── Features ─────────────────────────────────── */

    .features {
      background: var(--bg);
      padding: 5rem 1.5rem;
      border-top: 1px solid var(--border);
    }
    .features-inner {
      max-width: 1080px;
      margin: 0 auto;
    }
    .features-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--brand);
      margin-bottom: 2.5rem;
    }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem 4rem;
    }
    .feature-item {
      display: grid;
      grid-template-columns: 24px 1fr;
      column-gap: 0.875rem;
      row-gap: 0.2rem;
    }
    .feature-icon {
      grid-column: 1;
      grid-row: 1;
      color: var(--brand);
      margin-top: 3px;
      flex-shrink: 0;
    }
    .feature-label {
      grid-column: 2;
      grid-row: 1;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
    }
    .feature-body {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.9375rem;
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 52ch;
    }

    /* ─── Deck badges (inside feature item) ─────── */

    .feature-decks {
      grid-column: 2;
      grid-row: 3;
      display: flex;
      gap: 0.375rem;
      margin-top: 0.25rem;
      flex-wrap: wrap;
    }
    .deck-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 7px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #fff;
    }

    /* ─── Footer ──────────────────────────────────── */

    footer {
      background: var(--brand-dark);
      padding: 2.5rem 1.5rem;
