---
export const prerender = true;

import '../styles/marketing.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AmbientKanji from '../components/AmbientKanji.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import JlptBadges from '../components/JlptBadges.astro';
import { appStore, webApp, grammar, privacy } from '../data/links';

const title = "Jengo — Japanese Dictionary & Flashcards, Offline";
const description = "A full Japanese dictionary and spaced-repetition flashcards in one offline app. Look up any word by kanji, kana, romaji, English, or handwriting — and add it to your deck in a tap. JLPT N5–N1 decks built in.";
const canonical = "https://jengolang.com/jengo";

const faqs = [
  {
    q: "Does Jengo work offline?",
    a: "Yes. The full dictionary and all your decks live on your device. It syncs to the web when you're back online.",
  },
  {
    q: "What platforms is it on?",
    a: "iPhone and any web browser today, with your words synced between them.",
  },
  {
    q: "Can I look up a kanji I can't type?",
    a: "Yes — draw it with handwriting search, or search by reading, romaji, or English meaning.",
  },
  {
    q: "Does it have JLPT vocabulary?",
    a: "Yes — JLPT N5 through N1 decks are built in, and you can import your own word lists.",
  },
  {
    q: "How is this different from Anki + jisho.org?",
    a: "It's both in one app. You look a word up and add it to spaced-repetition flashcards in a single tap — cleaner and more intuitive, with no jumping between tools.",
  },
  {
    q: "What kind of flashcard scheduling does it use?",
    a: "A modern FSRS scheduler (Free Spaced Repetition Scheduler) that shows each word right before you'd forget it.",
  },
];

const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Jengo",
  applicationCategory: "EducationApplication",
  operatingSystem: "iOS, Web",
  description,
  url: canonical,
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const heroChars = [
  { c: "言", x: "6%",  y: "10%", s: "1.9rem", op: 0.15, dur: "7.2s", del: "0s" },
  { c: "語", x: "91%", y: "14%", s: "2.2rem", op: 0.14, dur: "8.5s", del: "1.3s" },
  { c: "読", x: "3%",  y: "48%", s: "1.6rem", op: 0.12, dur: "6.8s", del: "2.7s" },
  { c: "書", x: "89%", y: "42%", s: "2rem",   op: 0.15, dur: "9.1s", del: "0.6s" },
  { c: "文", x: "12%", y: "78%", s: "1.8rem", op: 0.11, dur: "7.6s", del: "3.8s" },
  { c: "字", x: "84%", y: "72%", s: "1.7rem", op: 0.14, dur: "8.2s", del: "1.9s" },
  { c: "知", x: "8%",  y: "30%", s: "2.3rem", op: 0.08, dur: "9.8s", del: "5.1s" },
  { c: "学", x: "87%", y: "58%", s: "1.8rem", op: 0.14, dur: "6.6s", del: "0.4s" },
  { c: "意", x: "44%", y: "5%",  s: "1.7rem", op: 0.08, dur: "10s",  del: "6.2s" },
  { c: "覚", x: "72%", y: "8%",  s: "2rem",   op: 0.12, dur: "8.7s", del: "1.1s" },
];

const loopSteps = [
  { n: 1, label: "Look it up",     img: "/app-dict-search.png",     alt: "Searching the Jengo dictionary by kana, kanji, romaji, or English" },
  { n: 2, label: "Add it in a tap", img: "/app-dict-entry.png",      alt: "A Jengo dictionary entry with a one-tap add-to-deck button" },
  { n: 3, label: "Review offline",  img: "/app-flashcard-front.png", alt: "A Jengo flashcard ready to review, fully offline" },
];

const showcase = [
  { img: "/app-decks.png",          heading: "Import premade decks (JLPT included).",             jp: "単語帳", imgOrder: 0, textOrder: 1, rot: -2, alt: "Jengo premade word sets — JLPT N5 through N1 with word counts" },
  { img: "/app-multicard.png",      heading: "Waste less time. Fly through words with multiview.", jp: "速習",  imgOrder: 1, textOrder: 0, rot: 2,  alt: "Jengo multi-card review — clearing a list of known words at once" },
  { img: "/app-flashcard-back.png", heading: "Spend your time where it matters in the single view.", jp: "集中", imgOrder: 0, textOrder: 1, rot: -2, alt: "A Jengo flashcard answer in single view showing definitions and example sentences" },
  { img: "/app-handwriting.png",    heading: "Can't type a kanji? Draw it.",                      jp: "手書き", imgOrder: 1, textOrder: 0, rot: 2,  alt: "Jengo handwriting search — drawing a kanji by hand to look it up" },
  { img: "/app-explain.png",        heading: "On-demand plain-English explanations.",             jp: "解説",  imgOrder: 0, textOrder: 1, rot: -2, alt: "Jengo plain-English explanation of a Japanese word" },
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Onest:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <style>
    /* ─── Hero (dictionary entry) ─────────────────── */
    .promo-hero { background: var(--brand-dark); padding: 5rem 1.5rem 4.5rem; position: relative; overflow: hidden; }
    .promo-hero-inner { max-width: 680px; margin: 0 auto; position: relative; z-index: 1; padding-left: 2.25rem; }
    .promo-headword { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
    .promo-word { font-family: var(--font-serif); font-size: clamp(3rem, 2rem + 4vw, 4.8rem); font-weight: 500; line-height: 0.95; color: var(--on-dark); letter-spacing: -0.01em; }
    .promo-reading { font-family: var(--font-jp); font-size: 1.1rem; font-weight: 500; color: var(--accent-green); }
    .promo-say { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid oklch(74% 0.11 145 / 0.5); color: var(--accent-green); align-self: center; flex-shrink: 0; }
    .promo-tags { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.25rem; }
    .promo-tag { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.07em; border-radius: 5px; padding: 5px 11px; font-weight: 500; }
    .promo-tag--dict  { background: var(--accent-green); color: var(--brand-dark); }
    .promo-tag--cards { background: var(--amber-2); color: var(--brand-dark); }
    .promo-tag--gram  { border: 1px solid oklch(99.5% 0.002 156 / 0.35); color: var(--on-dark-75); }
    .promo-def { display: flex; gap: 1.1rem; margin-top: 2rem; margin-left: -2.25rem; }
    .promo-def-n { font-family: var(--font-mono); font-size: 0.95rem; color: var(--amber-2); flex-shrink: 0; width: 1.15rem; padding-top: 0.4rem; }
    .promo-def h1 { font-family: var(--font-serif); font-size: clamp(1.7rem, 1.25rem + 2.1vw, 2.7rem); font-weight: 500; line-height: 1.15; color: oklch(93% 0.015 150); margin: 0; }
    .promo-def p { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.15rem, 0.95rem + 1vw, 1.6rem); color: oklch(82% 0.04 150); margin: 0.5rem 0 0; }
    .promo-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 2.5rem; }

    /* ─── Platform strip ──────────────────────────── */
    .plat-row { display: flex; align-items: flex-end; justify-content: center; gap: 3.5rem; flex-wrap: wrap; }
    .plat-browser { position: relative; flex: 1; min-width: 340px; max-width: 600px; }
    .plat-phone { position: relative; }

    /* ─── Loop ────────────────────────────────────── */
    .loop-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 2.5rem; }
    .loop-step { display: flex; flex-direction: column; gap: 1.25rem; }
    .loop-head { display: flex; align-items: baseline; gap: 0.7rem; }
    .loop-num { font-family: var(--font-serif); font-size: 2.4rem; font-weight: 500; line-height: 1; color: var(--amber-2); }
    .loop-label { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 500; color: var(--on-dark); }

    /* ─── Showcase ────────────────────────────────── */
    .show-inner { max-width: 1040px; margin: 0 auto; display: flex; flex-direction: column; gap: 5rem; }
    .show-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2.5rem 4rem; align-items: center; }
    .show-media { display: flex; justify-content: center; }
    .show-text { display: flex; flex-direction: column; gap: 0.9rem; }
    .show-jp { font-family: var(--font-jp); font-size: 1rem; color: var(--amber); }
    .show-h { font-family: var(--font-serif); font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.3rem); font-weight: 500; letter-spacing: -0.01em; line-height: 1.12; color: var(--text); margin: 0; }

    /* ─── Features ────────────────────────────────── */
    .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2.5rem 4rem; }
    .feat { display: flex; gap: 0.875rem; align-items: flex-start; }
    .feat-icon { color: var(--brand); margin-top: 3px; flex-shrink: 0; display: inline-flex; }
    .feat-label { font-size: 1rem; font-weight: 600; color: var(--text); margin: 0 0 0.2rem; }
    .feat-body { font-size: 0.9375rem; color: var(--text-2); line-height: 1.6; max-width: 52ch; margin: 0; }
    .feat-badges { margin-top: 0.625rem; }

    /* ─── Secondary CTA ───────────────────────────── */
    .pcta { background: var(--bg-tint); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); padding: 4.5rem 1.5rem; text-align: center; }
    .pcta-inner { max-width: 540px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
    .pcta-h { font-family: var(--font-serif); font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.3rem); font-weight: 500; letter-spacing: -0.01em; line-height: 1.15; color: var(--text); margin: 0; }
    .pcta-sub { font-family: var(--font-serif); font-size: clamp(1.35rem, 1.1rem + 1.1vw, 1.8rem); font-weight: 500; color: oklch(40% 0.085 152); margin: -0.5rem 0 0; }
    .pcta-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.25rem; align-items: center; justify-content: center; }

    /* ─── Creator ─────────────────────────────────── */
    .creator { background: var(--bg); padding: 5rem 1.5rem; }
    .creator-inner { max-width: 780px; margin: 0 auto; display: grid; grid-template-columns: 1fr 200px; gap: 3rem; align-items: center; }
    .creator-text { display: flex; flex-direction: column; gap: 1rem; }
    .creator-h { font-family: var(--font-serif); font-size: clamp(1.7rem, 1.25rem + 1.9vw, 2.4rem); font-weight: 500; letter-spacing: -0.01em; line-height: 1.1; color: var(--text); margin: 0; }
    .creator-body { font-size: 1.0625rem; color: var(--text-2); line-height: 1.75; margin: 0; }
    .creator-body strong { color: oklch(30% 0.02 120); font-weight: 700; }
    .creator-sign { font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--brand); margin: 0.25rem 0 0; }
    .creator-photo { width: 200px; height: 200px; border-radius: 14px; object-fit: cover; object-position: 50% 22%; border: 1px solid var(--hairline); transform: rotate(1.4deg); box-shadow: 0 16px 36px -12px oklch(24% 0.05 150 / 0.25); }
    @media (max-width: 560px) {
      .creator-inner { grid-template-columns: 1fr; justify-items: start; }
      .creator-photo { order: -1; }
    }

    /* ─── What's next ─────────────────────────────── */
    .next { background: var(--bg-tint); border-top: 1px solid var(--hairline); padding: 4.5rem 1.5rem; }
    .next-inner { max-width: 640px; margin: 0 auto; text-align: center; }
    .next-eyebrow { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; color: var(--amber); margin: 0 0 0.75rem; }
    .next-h { font-family: var(--font-serif); font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.2rem); font-weight: 500; letter-spacing: -0.01em; line-height: 1.15; color: var(--text); margin: 0; }
    .next-list { list-style: none; max-width: 500px; margin: 2rem auto 0; text-align: left; display: flex; flex-direction: column; gap: 1rem; }
    .next-item { display: flex; align-items: flex-start; gap: 0.875rem; font-size: 1.0625rem; color: var(--text-2); line-height: 1.5; }
    .next-tag { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; min-width: 54px; padding: 0.2rem 0.55rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.06em; margin-top: 0.2rem; }
    .next-tag--next { background: var(--amber); color: var(--on-dark); }
    .next-tag--soon { background: var(--brand); color: var(--on-dark); }
    .next-tag--beta { background: transparent; border: 1.5px solid var(--brand); color: var(--brand); }

    /* ─── FAQ ─────────────────────────────────────── */
    .faq-inner { max-width: 760px; margin: 0 auto; }
    .faq-item { border-bottom: 1px solid var(--hairline); padding: 1.5rem 0; }
    .faq-q { font-family: var(--font-serif); font-size: 1.2rem; font-weight: 500; color: var(--text); margin: 0 0 0.375rem; }
    .faq-a { font-size: 1rem; color: var(--text-2); line-height: 1.7; max-width: 62ch; margin: 0; }

    /* ─── Sticky mobile CTA ───────────────────────── */
    .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; background: oklch(99% 0.003 156 / 0.92); backdrop-filter: blur(10px); border-top: 1px solid var(--hairline); padding: 0.625rem 1rem calc(0.625rem + env(safe-area-inset-bottom)); display: none; }
    .sticky-cta :global(.mk-appstore) { width: 100%; justify-content: center; }
    @media (max-width: 600px) {
      .sticky-cta { display: block; }
      body { padding-bottom: 4.5rem; }
      .plat-browser { display: none; }
    }

    /* ─── Hero entrance ───────────────────────────── */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: no-preference) {
      .promo-hero-inner > * { opacity: 0; animation: fadeUp 0.5s var(--ease-out) forwards; }
      .promo-hero-inner > *:nth-child(1) { animation-delay: 0.05s; }
      .promo-hero-inner > *:nth-child(2) { animation-delay: 0.12s; }
      .promo-hero-inner > *:nth-child(3) { animation-delay: 0.19s; }
      .promo-hero-inner > *:nth-child(4) { animation-delay: 0.26s; }
    }
  </style>
</head>

<body>
  <SiteNav
    wordmark="Jengo"
    homeHref="/"
    links={[
      { label: "GRAMMAR", href: grammar },
      { label: "FEATURES", href: "#features" },
      { label: "FAQ", href: "#faq" },
    ]}
    cta={{ label: "OPEN IN BROWSER", href: webApp }}
  />

  <!-- Hero: dictionary entry -->
  <section class="promo-hero" aria-labelledby="hero-heading">
    <AmbientKanji chars={heroChars} />
    <div class="promo-hero-inner">
      <div class="promo-headword">
        <span class="promo-word">Jengo</span>
        <span class="promo-reading">【ジェンゴ】</span>
        <span class="promo-say" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
        </span>
      </div>
      <div class="promo-tags">
        <span class="promo-tag promo-tag--dict">DICTIONARY</span>
        <span class="promo-tag promo-tag--cards">FLASHCARDS</span>
        <span class="promo-tag promo-tag--gram">GRAMMAR</span>
      </div>
      <div class="promo-def">
        <span class="promo-def-n" aria-hidden="true">1.</span>
        <div>
          <h1 id="hero-heading">Built for serious Japanese study.</h1>
          <p>Built for you.</p>
        </div>
      </div>
      <div class="promo-actions">
        <AppStoreButton href={appStore} theme="white" />
        <a href={webApp} class="mk-link mk-link--green">OPEN IN BROWSER →</a>
      </div>
    </div>
  </section>

  <!-- §01 Platform strip -->
  <section class="mk-sec mk-sec--light" aria-labelledby="platform-heading">
    <div class="mk-wrap">
      <SectionHeader num="§01" title="On iPhone, and in any browser." jp="どこでも" id="platform-heading" mb="3.5rem" />
      <div class="plat-row">
        <div class="plat-browser">
          <BrowserFrame src="/app-web-home.png" alt="Jengo running in a web browser — the study home with a review forecast and flashcards ready to review" url="app.jengolang.com" />
          <div class="mk-annot" style="left:-0.5rem;bottom:-2rem;" aria-hidden="true">
            <svg width="30" height="14" viewBox="0 0 30 14" fill="none" stroke="var(--amber)" stroke-width="1.4"><path d="M0 13 L20 2 L14 2 M20 2 L20 8"/></svg>
            no install — runs in the browser
          </div>
        </div>
        <div class="plat-phone">
          <PhoneFrame src="/app-dict-entry.png" alt="Jengo on iPhone — a dictionary entry with reading, meanings, and example sentences" width={200} />
          <div class="mk-annot" style="left:50%;bottom:-2rem;transform:translateX(-50%);" aria-hidden="true">
            <svg width="22" height="14" viewBox="0 0 22 14" fill="none" stroke="var(--amber)" stroke-width="1.4"><path d="M11 13 L11 4 M11 4 L6 9 M11 4 L16 9"/></svg>
            same deck on both — synced
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- §02 The loop -->
  <section class="mk-sec mk-sec--dark" aria-labelledby="loop-heading">
    <div class="mk-wrap" style="max-width:940px;">
      <SectionHeader num="§02" title="One loop. Not two apps." jp="くりかえし" tone="dark" id="loop-heading" />
      <div class="loop-grid">
        {loopSteps.map((step) => (
          <div class="loop-step">
            <div class="loop-head">
              <span class="loop-num">{step.n}</span>
              <span class="loop-label">{step.label}</span>
            </div>
            <div class="mk-phone" style="width:100%;max-width:210px;">
              <div class="mk-phone-screen"><img src={step.img} alt={step.alt} loading="lazy" /></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Showcase -->
  <section class="mk-sec mk-sec--alt" aria-label="A closer look at Jengo">
    <div class="show-inner">
      {showcase.map((row) => (
        <div class="show-row">
          <div class="show-media" style={`order:${row.imgOrder}`}>
            <PhoneFrame src={row.img} alt={row.alt} width={224} rotate={row.rot} />
          </div>
          <div class="show-text" style={`order:${row.textOrder}`}>
            <span class="show-jp">{row.jp}</span>
            <h2 class="show-h">{row.heading}</h2>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- §03 Features -->
  <section id="features" class="mk-sec mk-sec--light" aria-labelledby="features-heading">
    <div class="mk-wrap">
      <SectionHeader num="§03" title="Everything in the box." jp="ぜんぶ" id="features-heading" mb="2.75rem" />
      <div class="feat-grid">

        <div class="feat">
          <span class="feat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/><line x1="12" y1="7" x2="12" y2="13"/><line x1="9" y1="10" x2="15" y2="10"/></svg></span>
          <div>
            <p class="feat-label">Add to flashcards in a tap</p>
            <p class="feat-body">Straight from the dictionary entry, with the reading, audio, and examples attached.</p>
          </div>
        </div>

        <div class="feat">
          <span class="feat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
          <div>
            <p class="feat-label">An array of search tools</p>
            <p class="feat-body">Draw it, or type romaji, kana, kanji, or English. Use wildcards, or paste a whole sentence to look up every word at once.</p>
          </div>
        </div>

        <div class="feat">
          <span class="feat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.36 6.64A9 9 0 0 1 20.77 15"/><path d="M6.16 6.16a9 9 0 1 0 12.68 12.68"/><path d="M12 2v4"/><line x1="2" y1="2" x2="22" y2="22"/></svg></span>
          <div>
            <p class="feat-label">Works fully offline</p>
            <p class="feat-body">The entire dictionary and your decks live on your device. Syncs to the web when you're back online.</p>
          </div>
        </div>

