          { s: 'です。',      inert: true },
        ],
        select: ['図書館', '難しい', '楽しかった'],
      },
    ];

    function _sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    async function _typewriter(text, el, ms) {
      el.textContent = '';
      for (const ch of [...text]) { el.textContent += ch; await _sleep(ms); }
    }

    function _renderTokens(tokens, paraEl) {
      paraEl.innerHTML = '';
      tokens.forEach(tok => {
        const el = document.createElement('span');
        el.textContent = tok.s;
        if (!tok.inert) {
          el.className = 'demo-word' + (tok.known ? ' demo-word-known' : '');
          el.dataset.surface = tok.s;
        }
        paraEl.appendChild(el);
      });
    }

    function _showDict(tok) {
      document.getElementById('demo-dict-surface').textContent = tok.s;
      document.getElementById('demo-dict-reading').textContent = tok.r ? `[${tok.r}]` : '';
      document.getElementById('demo-dict-pos').textContent = tok.pos;
      document.getElementById('demo-dict-meanings').innerHTML = tok.m.map(m => `<li>${m}</li>`).join('');
      document.getElementById('demo-dict').classList.add('visible');
    }

    function _hideDict() {
      document.getElementById('demo-dict').classList.remove('visible');
    }

    function _placeCursor(wordEl, frameEl, cursorEl, instant) {
      const frameRect = frameEl.getBoundingClientRect();
      const wordRect = wordEl.getBoundingClientRect();
      const left = wordRect.right - frameRect.left - 4; // tip sits just right of the word
      const top = wordRect.bottom - frameRect.top + 2; // tip sits just below the word
      if (instant) {
        cursorEl.style.transition = 'opacity 0.2s';
        cursorEl.style.left = left + 'px';
        cursorEl.style.top = top + 'px';
        cursorEl.offsetHeight; // force reflow
        cursorEl.style.transition = '';
      } else {
        cursorEl.style.left = left + 'px';
        cursorEl.style.top = top + 'px';
      }
    }

    async function _runRound(round) {
      const paraEl = document.getElementById('demo-para');
      const chipsEl = document.getElementById('demo-chips');
      const submitBtn = document.getElementById('demo-submit-btn');
      const frameEl = document.querySelector('.demo-frame');
      const cursorEl = document.getElementById('demo-cursor');

      paraEl.textContent = '';
      chipsEl.innerHTML = '';
      _hideDict();
      cursorEl.classList.remove('visible');
      submitBtn.classList.remove('ready', 'fire');

      for (const word of round.due) {
        await _sleep(160);
        const chip = document.createElement('span');
        chip.className = 'demo-chip';
        chip.textContent = word;
        chipsEl.appendChild(chip);
      }

      await _sleep(520);

      await _typewriter(round.tokens.map(t => t.s).join(''), paraEl, 40);
      await _sleep(520);
      _renderTokens(round.tokens, paraEl);
      await _sleep(400);

      let firstWord = true;
      for (const surface of round.select) {
        const wordEl = paraEl.querySelector(`[data-surface="${surface}"]`);
        const tok = round.tokens.find(t => t.s === surface);
        if (!wordEl || !tok) continue;

        // Move cursor to word (instant placement on first, animated after)
        _placeCursor(wordEl, frameEl, cursorEl, firstWord);
        if (firstWord) { cursorEl.classList.add('visible'); firstWord = false; }
        await _sleep(480); // cursor arrives

        wordEl.classList.add('demo-word-selected');
        _showDict(tok);
        await _sleep(1900);
      }

      await _sleep(500);
      cursorEl.classList.remove('visible');
      submitBtn.classList.add('ready');
      await _sleep(650);
      submitBtn.classList.add('fire');
      await _sleep(280);
      submitBtn.classList.remove('fire');
      await _sleep(380);
    }

    async function _demoLoop() {
      while (true) {
        for (const round of DEMO_ROUNDS) {
          await _runRound(round);
          await _sleep(350);
        }
        await _sleep(1800);
      }
    }

    const _demoEl = document.getElementById('demo');
    const _obs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        _obs.disconnect();
        _sleep(700).then(_demoLoop);
      }
    }, { threshold: 0.25 });
    _obs.observe(_demoEl);
  </script>

</body>
</html>
