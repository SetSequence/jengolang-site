---
// Dark marketing footer.
import JLogo from "./JLogo.astro";
interface Link { label: string; href: string }
interface Props {
  wordmark: string;
  links: Link[];
  homeHref?: string;
}
const { wordmark, links, homeHref = '/' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="mk-foot">
  <div class="mk-foot-inner">
    <a href={homeHref} class="mk-foot-brand" aria-label={`${wordmark} home`}>
      <JLogo size={22} />
      <span class="mk-foot-wordmark">{wordmark}</span>
    </a>
    <ul class="mk-foot-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </div>
  <p class="mk-foot-copy">&copy; {year} {wordmark}. All rights reserved.</p>
</footer>
