---
// macOS browser chrome (traffic lights + URL bar) around a web screenshot.
interface Props {
  src: string;
  alt: string;
  url?: string;
}
const { src, alt, url = 'app.jengolang.com' } = Astro.props;
---
<div class="mk-browser">
  <div class="mk-browser-bar">
    <span class="mk-browser-dot" style="background:#ff5f57"></span>
    <span class="mk-browser-dot" style="background:#febc2e"></span>
    <span class="mk-browser-dot" style="background:#28c840"></span>
    <div class="mk-browser-url"><span>{url}</span></div>
  </div>
  <div class="mk-browser-screen">
    <img src={src} alt={alt} loading="lazy" />
  </div>
</div>
