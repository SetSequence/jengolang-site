---
// The Jengo "J" brand mark. Single source for the nav, footer, and hub card.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 512 512" aria-hidden="true"><rect width="512" height="512" fill="#357d5e"/><text x="256" y="360" font-family="Georgia, serif" font-size="320" font-weight="bold" fill="white" text-anchor="middle">J</text></svg>
