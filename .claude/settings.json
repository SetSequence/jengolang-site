{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard_generated.py",
            "statusMessage": "Guarding generated artifacts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/lint_grammar_node.py",
            "statusMessage": "Linting grammar node"
          }
        ]
      }
    ]
  }
}
